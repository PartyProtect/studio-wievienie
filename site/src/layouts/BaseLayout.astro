---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: 'nl' | 'en';
  currentPath?: string;
  ogImage?: string;
  noindex?: boolean;
  firstVisitAssembly?: boolean;
}

const {
  title,
  description,
  lang = 'nl',
  currentPath = '',
  ogImage,
  noindex = false,
  firstVisitAssembly = false,
} = Astro.props;

const fullTitle = title === 'Studio Wievien' ? title : `${title} — Studio Wievien`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://studiowievien.nl');
const ogImageURL = ogImage ? new URL(ogImage, canonicalURL).href : undefined;
const skipLabel = lang === 'nl' ? 'Naar inhoud' : 'Skip to content';
---

<!DOCTYPE html>
<html lang={lang} data-assembly-enabled={firstVisitAssembly ? 'true' : undefined}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f6f4ef" />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL.href} />

  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:site_name" content="Studio Wievien" />
  <meta property="og:locale" content={lang === 'nl' ? 'nl_NL' : 'en_US'} />
  {ogImageURL && <meta property="og:image" content={ogImageURL} />}

  <meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

  <script is:inline>
    (() => {
      const root = document.documentElement;
      if (root.dataset.assemblyEnabled !== 'true') return;

      const reduceMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
      if (reduceMotion) return;

      const forceReplay = new URLSearchParams(window.location.search).get('intro') === '1';
      let hasSeenIntro = false;

      try {
        hasSeenIntro = sessionStorage.getItem('studio-wievien-assembly-seen') === '1';
      } catch {
        // Storage can be unavailable in strict privacy modes; the intro still works.
      }

      if (!hasSeenIntro || forceReplay) {
        root.dataset.assembly = 'pending';
      }
    })();
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap"
    rel="stylesheet"
  />

  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main-content">{skipLabel}</a>
  <Header lang={lang} currentPath={currentPath} />

  <main id="main-content">
    <slot />
  </main>

  <Footer lang={lang} />

  <script is:inline>
    (() => {
      const root = document.documentElement;
      if (root.dataset.assembly !== 'pending') return;

      const play = async () => {
        const fontGate = document.fonts?.ready ?? Promise.resolve();
        const patience = new Promise((resolve) => window.setTimeout(resolve, 850));

        try {
          await Promise.race([fontGate, patience]);
        } catch {
          // A failed webfont must never prevent the site from opening.
        }

        requestAnimationFrame(() => {
          root.dataset.assembly = 'playing';

          try {
            sessionStorage.setItem('studio-wievien-assembly-seen', '1');
          } catch {
            // The visual effect does not depend on storage being available.
          }

          window.setTimeout(() => {
            root.dataset.assembly = 'done';
            window.setTimeout(() => root.removeAttribute('data-assembly'), 100);
          }, 9100);
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', play, { once: true });
      } else {
        play();
      }
    })();
  </script>
</body>
</html>
