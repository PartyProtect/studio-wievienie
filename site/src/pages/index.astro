---
import BaseLayout from '@/layouts/BaseLayout.astro';

const doors = [
  { number: '01', title: 'Werk', note: 'Mode, objecten & projecten', href: '#werk' },
  { number: '02', title: 'Fancy Boogers', note: 'Kledinglijn', href: '#fancy-boogers' },
  { number: '03', title: 'Borduurwerk', note: 'Textiel & opdrachten', href: '#borduurwerk' },
  { number: '04', title: 'Workshops', note: 'Samen maken', href: '#workshops' },
];

const heroImage = 'https://images.squarespace-cdn.com/content/v1/5bf404ca70e8026f5a085d80/92c0dc63-a0bc-4686-81b0-d0bcc698c06b/Unknown.jpeg';
const juunamImage = 'https://images.squarespace-cdn.com/content/v1/5bf404ca70e8026f5a085d80/1767703456320-YMAS5DUHNMV0VR29ZRLF/MVS_20251120_0093_WEB.jpg';
const projectImage = 'https://images.squarespace-cdn.com/content/v1/5bf404ca70e8026f5a085d80/1772014449994-RK7LCIFVZK23UJQJ4WWS/538A4606_JonathanWiddershoven.jpg';
---

<BaseLayout
  title="Studio Wievien"
  description="Studio Wievien — mode, textiel, borduurwerk, workshops, projecten en Fancy Boogers."
  lang="nl"
  currentPath="/"
>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">Studio Wievien · Maastricht</p>
      <h1>Mode, textiel, objecten en workshops.</h1>
      <p class="hero-lede">
        Van Fancy Boogers tot borduurwerk en projecten rond identiteit, materiaal en maken.
      </p>
      <a class="hero-link" href="#begin">Kijk rond <span aria-hidden="true">↓</span></a>
    </div>

    <!-- Temporary press image for the design prototype. Replace with owned/licensed photography before launch. -->
    <figure class="hero-figure">
      <img
        src={heroImage}
        alt="Ontwerp van Wievien met een lichtblauwe en lila hoofdvorm met kralen voor het gezicht"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>Studio Wievien · ontwerp / masker</figcaption>
    </figure>
  </section>

  <section class="start shell" id="begin" aria-labelledby="start-heading">
    <div class="section-intro">
      <p class="eyebrow">Begin hier</p>
      <h2 id="start-heading">Vier ingangen, één studio.</h2>
    </div>

    <div class="door-grid">
      {doors.map(({ number, title, note, href }) => (
        <a class="door" href={href}>
          <span class="door-number">{number}</span>
          <span class="door-main">
            <strong>{title}</strong>
            <small>{note}</small>
          </span>
          <span class="door-arrow" aria-hidden="true">↘</span>
        </a>
      ))}
    </div>
  </section>

  <section class="work" id="werk" aria-labelledby="work-heading">
    <div class="shell">
      <div class="section-heading-row">
        <div>
          <p class="eyebrow">Werk</p>
          <h2 id="work-heading">Een paar plekken om binnen te kijken.</h2>
        </div>
        <p class="section-note">De homepage blijft klein. Het archief mag later groot worden.</p>
      </div>

      <div class="work-layout">
        <!-- Temporary public event photography used to establish visual direction. -->
        <figure class="work-feature">
          <div class="image-frame image-frame-wide">
            <img
              src={juunamImage}
              alt="Kledingpresentatie op rekken tijdens FASHIONCLASH Festival 2025 bij Juunam"
              loading="lazy"
            />
          </div>
          <figcaption>
            <span>Presentatie</span>
            <strong>Studio Wievien · FASHIONCLASH 2025</strong>
          </figcaption>
        </figure>

        <div class="work-side">
          <figure class="work-small">
            <div class="image-frame image-frame-portrait">
              <img
                src={projectImage}
                alt="Model in een blauw en zilverkleurig experimenteel kostuum tijdens een FASHIONCLASH project"
                loading="lazy"
              />
            </div>
            <figcaption>
              <span>Projecten</span>
              <strong>Samenwerkingen & experiment</strong>
            </figcaption>
          </figure>

          <div class="work-statement">
            <p class="eyebrow">De praktijk</p>
            <p>
              Kleding, maskers, textiel, borduurwerk en projecten hoeven niet in één vakje te passen.
              <strong>Werk</strong> wordt straks de plek waar alles samenkomt.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="fancy" id="fancy-boogers" aria-labelledby="fancy-heading">
    <div class="shell fancy-inner">
      <div>
        <p class="eyebrow">Kledinglijn</p>
        <h2 id="fancy-heading">Fancy<br />Boogers</h2>
      </div>
      <div class="fancy-copy">
        <p>
          Een eigen kamer binnen Studio Wievien. Meer kleding, meer attitude, dezelfde hand erachter.
        </p>
        <span class="coming-soon">Collectiepagina volgt</span>
      </div>
    </div>
  </section>

  <section class="embroidery" id="borduurwerk" aria-labelledby="embroidery-heading">
    <div class="shell split-section">
      <div class="split-title">
        <p class="eyebrow">Textiel</p>
        <h2 id="embroidery-heading">Borduurwerk</h2>
      </div>
      <div class="split-copy">
        <p class="big-copy">
          Handwerk kan klein en precies zijn, of een kledingstuk volledig veranderen.
        </p>
        <p>
          Hier komt straks werk samen met informatie over opdrachten, technieken en wat er mogelijk is.
          Voor nu houden we de plek rustig totdat het echte materiaal erin zit.
        </p>
      </div>
    </div>
  </section>

  <section class="workshops" id="workshops" aria-labelledby="workshops-heading">
    <div class="shell split-section">
      <div class="split-title">
        <p class="eyebrow">Samen maken</p>
        <h2 id="workshops-heading">Workshops</h2>
      </div>
      <div class="split-copy">
        <p class="big-copy">Geen verzonnen kalender. Alleen workshops die echt gepland staan.</p>
        <p>
          Nieuwe data, locaties en praktische informatie krijgen hier een duidelijke plek zodra ze bekend zijn.
        </p>
        <a
          class="text-link"
          href="https://www.instagram.com/studio_wievien/"
          rel="noopener noreferrer"
          target="_blank"
        >Volg Studio Wievien op Instagram</a>
      </div>
    </div>
  </section>

  <section class="about" id="over" aria-labelledby="about-heading">
    <div class="shell about-inner">
      <p class="eyebrow">Over</p>
      <div class="about-grid">
        <h2 id="about-heading">Wievien werkt instinctief met mode, kleur, materiaal en identiteit.</h2>
        <div class="about-copy">
          <p>
            Haar praktijk beweegt tussen ontwerpen, maken en experimenteren. Maskers keren terug als een manier om
            verandering en identiteit te onderzoeken; daarnaast werkt ze met kleding, textiel en participatieve projecten.
          </p>
          <a
            class="text-link"
            href="https://www.instagram.com/studio_wievien/"
            rel="noopener noreferrer"
            target="_blank"
          >@studio_wievien</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: calc(100svh - 70px);
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(340px, 1.12fr);
    gap: clamp(2rem, 6vw, 6.5rem);
    align-items: center;
    padding-block: clamp(2.5rem, 5vw, 5rem);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 590px;
  }

  .hero h1 {
    margin-top: 1.1rem;
    font-size: clamp(3rem, 6.1vw, 6.5rem);
    line-height: 0.91;
    max-width: 8.6ch;
  }

  .hero-lede {
    margin-top: 1.8rem;
    max-width: 39rem;
    color: var(--text-mid);
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    line-height: 1.55;
  }

  .hero-link {
    margin-top: 2.5rem;
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
    padding: 0.82rem 1.05rem;
    border: 1px solid var(--text);
    font-size: 0.82rem;
    font-weight: 650;
    text-decoration: none;
    transition: background 180ms var(--ease), color 180ms var(--ease);
  }

  .hero-link:hover,
  .hero-link:focus-visible {
    background: var(--text);
    color: var(--bg);
  }

  .hero-figure {
    justify-self: end;
    width: min(100%, 660px);
  }

  .hero-figure img {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 39%;
    background: #f8f8f6;
  }

  .hero-figure figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.6rem;
    color: var(--text-light);
    font-size: 0.7rem;
  }

  .start {
    padding-block: var(--section);
  }

  .section-intro {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    align-items: end;
    margin-bottom: 2.2rem;
  }

  .section-intro h2,
  .section-heading-row h2,
  .split-title h2 {
    font-size: clamp(2.15rem, 4vw, 4.25rem);
    line-height: 0.98;
  }

  .door-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--border-dark);
    border-left: 1px solid var(--border-dark);
  }

  .door {
    min-height: 190px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.25rem;
    align-items: end;
    padding: clamp(1.2rem, 2.5vw, 2rem);
    border-right: 1px solid var(--border-dark);
    border-bottom: 1px solid var(--border-dark);
    text-decoration: none;
    transition: background 220ms var(--ease);
  }

  .door:hover,
  .door:focus-visible {
    background: var(--accent-soft);
  }

  .door-number {
    align-self: start;
    font-size: 0.72rem;
    color: var(--text-light);
  }

  .door-main {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .door-main strong {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3vw, 3rem);
    font-weight: 400;
    line-height: 1;
  }

  .door-main small {
    color: var(--text-mid);
    font-size: 0.78rem;
  }

  .door-arrow {
    font-size: 1.25rem;
  }

  .work {
    padding-block: var(--section);
    background: #eeebe5;
  }

  .section-heading-row {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(220px, 0.7fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .section-heading-row h2 {
    margin-top: 0.9rem;
    max-width: 14ch;
  }

  .section-note {
    color: var(--text-mid);
    max-width: 30ch;
    justify-self: end;
    font-size: 0.9rem;
  }

  .work-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(300px, 0.75fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    align-items: start;
  }

  .image-frame {
    overflow: hidden;
    background: var(--bg-soft);
  }

  .image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease);
  }

  figure:hover .image-frame img {
    transform: scale(1.015);
  }

  .image-frame-wide {
    aspect-ratio: 3 / 2;
  }

  .image-frame-portrait {
    aspect-ratio: 4 / 5;
  }

  .work-feature figcaption,
  .work-small figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.72rem;
  }

  .work-feature figcaption span,
  .work-small figcaption span {
    color: var(--text-light);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }

  .work-feature figcaption strong,
  .work-small figcaption strong {
    text-align: right;
    font-size: 0.8rem;
    font-weight: 650;
  }

  .work-side {
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  .work-statement {
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-dark);
  }

  .work-statement > p:last-child {
    margin-top: 1rem;
    font-family: var(--font-heading);
    font-size: clamp(1.45rem, 2.5vw, 2.45rem);
    line-height: 1.14;
  }

  .work-statement strong {
    font-weight: 400;
    font-style: italic;
  }

  .fancy {
    background: var(--bg-ink);
    color: var(--text-on-dark);
    padding-block: var(--section);
  }

  .fancy .eyebrow {
    color: #aaa59d;
  }

  .fancy-inner {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(3rem, 10vw, 10rem);
    align-items: end;
  }

  .fancy h2 {
    margin-top: 1rem;
    font-size: clamp(4rem, 10vw, 10rem);
    line-height: 0.73;
    letter-spacing: -0.055em;
    color: var(--text-on-dark);
  }

  .fancy-copy {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 28rem;
    padding-bottom: 0.5rem;
  }

  .fancy-copy p {
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    color: #d0cbc3;
  }

  .coming-soon {
    width: fit-content;
    padding: 0.55rem 0.75rem;
    border: 1px solid #68645e;
    color: #b8b2aa;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .embroidery,
  .workshops,
  .about {
    padding-block: var(--section);
  }

  .embroidery {
    background: var(--accent-soft);
  }

  .workshops {
    background: var(--bg);
    border-top: 1px solid var(--border);
  }

  .split-section {
    display: grid;
    grid-template-columns: minmax(260px, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(3rem, 9vw, 9rem);
  }

  .split-title h2 {
    margin-top: 0.9rem;
  }

  .split-copy {
    max-width: 42rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .split-copy .big-copy {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3.3vw, 3.3rem);
    line-height: 1.08;
  }

  .split-copy > p:not(.big-copy) {
    color: var(--text-mid);
    max-width: 38rem;
  }

  .about {
    background: var(--accent-lilac);
  }

  .about-inner > .eyebrow {
    margin-bottom: 1.2rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(280px, 0.6fr);
    gap: clamp(3rem, 9vw, 9rem);
    align-items: start;
  }

  .about h2 {
    font-size: clamp(2.4rem, 5.5vw, 5.6rem);
    line-height: 0.98;
    max-width: 12ch;
  }

  .about-copy {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    color: #514b56;
    max-width: 31rem;
    padding-top: 0.4rem;
  }

  @media (max-width: 850px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-top: 3rem;
      padding-bottom: 5rem;
    }

    .hero-copy {
      max-width: 100%;
    }

    .hero h1 {
      max-width: 9ch;
      font-size: clamp(3.6rem, 15vw, 6.3rem);
    }

    .hero-lede {
      max-width: 31rem;
    }

    .hero-figure {
      width: 100%;
      justify-self: stretch;
    }

    .hero-figure img {
      aspect-ratio: 4 / 4.65;
      object-position: 50% 34%;
    }

    .section-intro,
    .section-heading-row,
    .work-layout,
    .fancy-inner,
    .split-section,
    .about-grid {
      grid-template-columns: 1fr;
    }

    .section-intro,
    .section-heading-row {
      gap: 1rem;
    }

    .section-note {
      justify-self: start;
    }

    .work-side {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
      gap: 1rem;
    }

    .work-statement {
      margin-top: 0;
    }

    .fancy-inner {
      gap: 4rem;
    }

    .fancy h2 {
      font-size: clamp(4.6rem, 18vw, 8rem);
    }

    .split-section,
    .about-grid {
      gap: 2.5rem;
    }
  }

  @media (max-width: 600px) {
    .hero h1 {
      font-size: clamp(3.25rem, 17vw, 5.1rem);
    }

    .hero-link {
      margin-top: 1.8rem;
    }

    .door-grid {
      grid-template-columns: 1fr;
    }

    .door {
      min-height: 130px;
    }

    .work-side {
      grid-template-columns: 1fr;
      gap: 2.8rem;
    }

    .image-frame-portrait {
      aspect-ratio: 4 / 4.5;
    }

    .work-feature figcaption,
    .work-small figcaption {
      flex-direction: column;
      gap: 0.25rem;
    }

    .work-feature figcaption strong,
    .work-small figcaption strong {
      text-align: left;
    }

    .fancy h2 {
      font-size: clamp(4rem, 21vw, 6.5rem);
    }

    .about h2 {
      font-size: clamp(2.6rem, 13vw, 4.4rem);
    }
  }
</style>
