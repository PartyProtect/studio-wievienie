---
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkItem from '@/components/WorkItem.astro';
import { projects, workItems } from '@/data/content';
---

<BaseLayout
  title="Werk"
  description="Werk van Studio Wievien — mode, textiel, maskers, objecten en projecten."
  lang="nl"
  currentPath="/werk/"
>
  <header class="work-hero shell">
    <p class="eyebrow">Studio Wievien</p>
    <div class="work-hero-grid">
      <h1>Werk</h1>
      <div class="work-intro">
        <p>Mode, textiel, maskers, objecten en projecten.</p>
        <p class="work-fields">Kleding · objecten · textiel · presentaties · samenwerkingen</p>
      </div>
    </div>
  </header>

  <section class="work-gallery shell" aria-label="Selectie van werk">
    {workItems.map((item) => <WorkItem {...item} />)}
  </section>

  <section class="archive shell" aria-labelledby="archive-title">
    <header class="archive-heading">
      <p class="eyebrow">Archief</p>
      <h2 id="archive-title">Projecten & presentaties</h2>
    </header>

    <div class="archive-list">
      {projects.map(({ year, title, kind, place }) => (
        <div class="archive-row">
          <span class="archive-year">{year}</span>
          <strong>{title}</strong>
          <span class="archive-kind">{kind} · {place}</span>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .work-hero {
    padding-block: clamp(4.5rem, 9vw, 9rem) clamp(3.5rem, 7vw, 6rem);
    border-bottom: 1px solid var(--line-strong);
  }

  .work-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: clamp(3rem, 9vw, 10rem);
    align-items: end;
    margin-top: 1rem;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(5.5rem, 14vw, 13rem);
    font-weight: 400;
    line-height: 0.72;
    letter-spacing: -0.065em;
  }

  .work-intro {
    padding-bottom: 0.4rem;
  }

  .work-intro > p:first-child {
    max-width: 25rem;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 2.6vw, 2.35rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .work-fields {
    margin-top: 1rem;
    max-width: 31rem;
    color: var(--ink-faint);
    font-size: 0.66rem;
    line-height: 1.7;
  }

  .work-gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4.5rem) clamp(1rem, 2vw, 1.7rem);
    padding-block: var(--section);
  }

  .archive {
    padding-bottom: var(--section);
  }

  .archive-heading {
    display: grid;
    grid-template-columns: minmax(120px, 0.65fr) minmax(0, 1.35fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .archive-heading h2 {
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 5vw, 5rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .archive-list {
    border-top: 1px solid var(--line-strong);
  }

  .archive-row {
    display: grid;
    grid-template-columns: 80px minmax(0, 1.3fr) minmax(220px, 0.7fr);
    gap: 1rem;
    align-items: baseline;
    padding-block: 1.15rem;
    border-bottom: 1px solid var(--line);
  }

  .archive-row strong {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.8vw, 1.6rem);
    font-weight: 400;
    letter-spacing: -0.025em;
  }

  .archive-year,
  .archive-kind {
    color: var(--ink-faint);
    font-size: 0.64rem;
  }

  .archive-year {
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 900px) {
    .work-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .work-hero {
      padding-top: 4rem;
    }

    .work-hero-grid,
    .archive-heading {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    h1 {
      font-size: clamp(5.3rem, 29vw, 8rem);
    }

    .work-gallery {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .archive-row {
      grid-template-columns: 52px 1fr;
      gap: 0.25rem 0.9rem;
    }

    .archive-kind {
      grid-column: 2;
    }
  }
</style>
