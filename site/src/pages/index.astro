---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { heroWork, homepageProjects, homepageWork } from '@/data/content';

const sections = [
  { title: 'Werk', note: 'Selectie & projecten', href: '/werk/' },
  { title: 'Fancy Boogers', note: 'Kledinglijn', href: '#fancy-boogers' },
  { title: 'Borduurwerk', note: 'Textiel & opdrachten', href: '#borduurwerk' },
  { title: 'Workshops', note: 'Borduren · textiel · upcycling', href: '#workshops' },
];

const [juunamWork, carnivalWork] = homepageWork;
---

<BaseLayout
  title="Studio Wievien"
  description="Studio Wievien — mode, textiel, borduurwerk, objecten, projecten, workshops en Fancy Boogers."
  lang="nl"
  currentPath="/"
  ogImage={heroWork.image}
>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Wievien Alberts · Maastricht</p>
      <h1 id="hero-title">
        <span class="hero-word hero-word-studio">Studio</span>
        <span class="hero-word hero-word-wievien">Wievien</span>
      </h1>
      <p class="hero-fields">Mode · textiel · objecten · workshops</p>
      <a class="quiet-link" href="/werk/">Werk <span aria-hidden="true">→</span></a>
    </div>

    <figure class="hero-figure">
      <div class="hero-image-frame">
        <img
          src={heroWork.image}
          alt={heroWork.alt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <figcaption>
        <span>{heroWork.context}</span>
        <span>{heroWork.credit}</span>
      </figcaption>
    </figure>
  </section>

  <nav class="section-index shell" aria-label="Onderdelen van Studio Wievien">
    {sections.map(({ title, note, href }) => (
      <a class="section-link" href={href}>
        <span class="section-name">{title}</span>
        <span class="section-note">{note}</span>
      </a>
    ))}
  </nav>

  <section class="selection" id="werk" aria-labelledby="selection-title">
    <div class="shell">
      <header class="section-header">
        <p class="eyebrow">Werk</p>
        <h2 id="selection-title">Selectie</h2>
      </header>

      <div class="selection-grid">
        <figure class="selection-main">
          <div class="image-frame image-frame-landscape">
            <img
              src={juunamWork.image}
              alt={juunamWork.alt}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>
            <span>{juunamWork.category}</span>
            <strong>{juunamWork.title} · {juunamWork.context} {juunamWork.year}</strong>
            <small>{juunamWork.credit}</small>
          </figcaption>
        </figure>

        <figure class="selection-side">
          <div class="image-frame image-frame-portrait">
            <img
              src={carnivalWork.image}
              alt={carnivalWork.alt}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>
            <span>{carnivalWork.category}</span>
            <strong>{carnivalWork.title} · {carnivalWork.context} {carnivalWork.year}</strong>
            <small>{carnivalWork.credit}</small>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="fancy" id="fancy-boogers" aria-labelledby="fancy-title">
    <div class="shell fancy-grid">
      <div>
        <p class="eyebrow">Kledinglijn · Studio Wievien</p>
        <h2 id="fancy-title">Fancy Boogers</h2>
      </div>
      <div class="fancy-copy">
        <p>Eigen kledinglijn van Wievien Alberts.</p>
        <p class="fancy-meta">In 2026 verscheen werk uit de collectie op de cover van ECOPOLITAN #7.</p>
        <a
          class="dark-link"
          href="https://www.instagram.com/studio_wievien/"
          rel="noopener noreferrer"
          target="_blank"
        >@studio_wievien <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <div class="fancy-kinetic" aria-hidden="true">
      <div class="fancy-track">
        <span>Fancy Boogers · Studio Wievien · kleding · textiel · </span>
        <span>Fancy Boogers · Studio Wievien · kleding · textiel · </span>
        <span>Fancy Boogers · Studio Wievien · kleding · textiel · </span>
        <span>Fancy Boogers · Studio Wievien · kleding · textiel · </span>
      </div>
    </div>
  </section>

  <section class="practice shell" aria-label="Borduurwerk en workshops">
    <article class="practice-row" id="borduurwerk">
      <div class="practice-title">
        <p class="eyebrow">Textiel</p>
        <h2>Borduurwerk</h2>
      </div>
      <div class="practice-copy">
        <p>Borduurwerk en textielbewerking op kleding en andere dragers.</p>
        <small>Werk · technieken · opdrachten</small>
      </div>
    </article>

    <article class="practice-row" id="workshops">
      <div class="practice-title">
        <p class="eyebrow">Workshops</p>
        <h2>Samen maken</h2>
      </div>
      <div class="practice-copy">
        <p>Workshops rond borduren, textiel en upcycling.</p>
        <small>Studio Wievien · Maastricht</small>
      </div>
    </article>
  </section>

  <section class="projects shell" aria-labelledby="projects-title">
    <header class="projects-heading">
      <p class="eyebrow">Projecten & presentaties</p>
      <h2 id="projects-title">2024–2026</h2>
    </header>

    <div class="project-list">
      {homepageProjects.map(({ year, title, place }) => (
        <div class="project-row">
          <span class="project-year">{year}</span>
          <strong>{title}</strong>
          <span>{place}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="about shell" id="over" aria-labelledby="about-title">
    <div class="about-heading">
      <p class="eyebrow">Over</p>
      <h2 id="about-title">Wievien Alberts</h2>
    </div>
    <div class="about-copy">
      <p>
        Wievien Alberts is ontwerper en werkt met kleding, textiel, maskers en objecten.
        In haar werk keren identiteit, verandering en het masker als vorm regelmatig terug.
        Daarnaast werkt ze aan gezamenlijke projecten en geeft ze workshops.
      </p>
      <a
        class="text-link"
        href="https://www.instagram.com/studio_wievien/"
        rel="noopener noreferrer"
        target="_blank"
      >Instagram ↗</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: calc(100svh - 64px);
    display: grid;
    grid-template-columns: minmax(0, 0.84fr) minmax(390px, 1.16fr);
    gap: clamp(3rem, 7vw, 8rem);
    align-items: center;
    padding-block: clamp(3.5rem, 6vw, 6.5rem);
  }

  .hero-copy {
    max-width: 610px;
  }

  .hero h1 {
    margin-top: 1rem;
    font-size: clamp(4.35rem, 8.5vw, 8.7rem);
    line-height: 0.79;
    letter-spacing: -0.058em;
  }

  .hero-word {
    display: block;
    transform-origin: left center;
    transition:
      transform 700ms var(--ease),
      font-style 350ms var(--ease);
  }

  .hero-fields {
    margin-top: 2.15rem;
    color: var(--ink-soft);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.035em;
  }

  .hero .quiet-link {
    margin-top: 2.25rem;
  }

  .hero-figure {
    justify-self: end;
    width: min(100%, 690px);
  }

  .hero-image-frame {
    overflow: hidden;
    background: var(--surface);
    border: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }

  .hero-figure img {
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: 50% 42%;
  }

  .hero-figure figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.58rem;
    color: var(--ink-faint);
    font-size: 0.61rem;
    letter-spacing: 0.01em;
  }

  .section-index {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2rem, 7vw, 7rem);
    margin-bottom: var(--section);
    border-top: 1px solid var(--line-strong);
  }

  .section-link {
    min-height: 106px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.6rem 1rem;
    align-content: center;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .section-name {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.5vw, 2.45rem);
    line-height: 1;
    letter-spacing: -0.035em;
    transform-origin: left center;
    transition:
      transform 420ms var(--ease),
      font-style 180ms var(--ease);
  }

  .section-note {
    align-self: center;
    color: var(--ink-faint);
    font-size: 0.64rem;
    text-align: right;
    transition: transform 420ms var(--ease), color 220ms var(--ease);
  }

  .selection {
    padding-block: var(--section);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .section-header,
  .projects-heading {
    display: grid;
    grid-template-columns: minmax(120px, 0.65fr) minmax(0, 1.35fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: clamp(2.7rem, 5vw, 4.7rem);
  }

  .section-header h2,
  .practice h2,
  .projects h2,
  .about h2 {
    font-size: clamp(2.6rem, 4.8vw, 4.9rem);
    line-height: 0.9;
  }

  .selection-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.58fr) minmax(300px, 0.72fr);
    gap: clamp(1.2rem, 2.5vw, 2rem);
    align-items: start;
  }

  .image-frame {
    overflow: hidden;
    background: var(--surface);
    border: 1px solid color-mix(in srgb, var(--line) 68%, transparent);
  }

  .image-frame img {
    height: 100%;
    object-fit: cover;
    transition: transform 420ms var(--ease);
  }

  figure:hover .image-frame img {
    transform: scale(1.004);
  }

  .image-frame-landscape {
    aspect-ratio: 3 / 2;
  }

  .image-frame-portrait {
    aspect-ratio: 4 / 5;
  }

  .selection figcaption {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.18rem 1rem;
    padding-top: 0.63rem;
  }

  .selection figcaption span,
  .selection figcaption small {
    color: var(--ink-faint);
    font-size: 0.59rem;
  }

  .selection figcaption span {
    text-transform: uppercase;
    letter-spacing: 0.085em;
  }

  .selection figcaption strong {
    justify-self: end;
    text-align: right;
    font-size: 0.67rem;
    font-weight: 600;
  }

  .selection figcaption small {
    grid-column: 2;
    justify-self: end;
  }

  .fancy {
    padding-block: clamp(6rem, 10vw, 10rem) 0;
    overflow: hidden;
    background: var(--dark);
    color: var(--on-dark);
  }

  .fancy .eyebrow {
    color: var(--on-dark-soft);
  }

  .fancy-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.65fr);
    gap: clamp(3rem, 8vw, 9rem);
    align-items: end;
  }

  .fancy h2 {
    margin-top: 0.8rem;
    max-width: 10ch;
    font-size: clamp(3.8rem, 7vw, 7rem);
    line-height: 0.82;
    letter-spacing: -0.055em;
  }

  .fancy-copy {
    padding-bottom: 0.25rem;
  }

  .fancy-copy p {
    max-width: 23rem;
    color: var(--on-dark-soft);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .fancy-copy .fancy-meta {
    margin-top: 0.75rem;
    color: #84817c;
    font-size: 0.68rem;
  }

  .dark-link {
    display: inline-flex;
    gap: 0.45rem;
    margin-top: 1.65rem;
    padding-bottom: 0.18rem;
    border-bottom: 1px solid #67645f;
    color: var(--on-dark);
    font-size: 0.72rem;
    font-weight: 600;
    text-decoration: none;
  }

  .fancy-kinetic {
    margin-top: clamp(4rem, 8vw, 8rem);
    overflow: hidden;
    border-top: 1px solid #343331;
    border-bottom: 1px solid #343331;
    padding-block: 0.95rem;
  }

  .fancy-track {
    display: flex;
    width: max-content;
    color: #8f8b85;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    white-space: nowrap;
    animation: fancyFlow 26s linear infinite;
  }

  .fancy-track span {
    padding-right: 2.2rem;
  }

  @keyframes fancyFlow {
    to {
      transform: translateX(-25%);
    }
  }

  .practice {
    padding-block: var(--section);
  }

  .practice-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.75fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: center;
    padding-block: clamp(2.6rem, 5vw, 4.6rem);
    border-top: 1px solid var(--line);
  }

  .practice-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .practice-title h2 {
    margin-top: 0.7rem;
  }

  .practice-copy {
    max-width: 30rem;
  }

  .practice-copy p {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.2vw, 2rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .practice-copy small {
    display: block;
    margin-top: 0.9rem;
    color: var(--ink-faint);
    font-size: 0.63rem;
  }

  .projects {
    padding-bottom: var(--section);
  }

  .project-list {
    border-top: 1px solid var(--line-strong);
  }

  .project-row {
    display: grid;
    grid-template-columns: 90px minmax(0, 1.35fr) minmax(180px, 0.65fr);
    gap: 1rem;
    align-items: baseline;
    padding-block: 1.12rem;
    border-bottom: 1px solid var(--line);
  }

  .project-row strong {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.85vw, 1.62rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    transform-origin: left center;
    transition: transform 340ms var(--ease);
  }

  .project-year,
  .project-row > span:last-child {
    color: var(--ink-faint);
    font-size: 0.65rem;
  }

  .project-year {
    font-variant-numeric: tabular-nums;
  }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
    gap: clamp(3rem, 8vw, 9rem);
    align-items: start;
    padding-block: var(--section);
    border-top: 1px solid var(--line-strong);
  }

  .about-heading h2 {
    margin-top: 0.75rem;
  }

  .about-copy {
    padding-top: 0.2rem;
  }

  .about-copy p {
    max-width: 37rem;
    font-family: var(--font-display);
    font-size: clamp(1.28rem, 2vw, 1.9rem);
    line-height: 1.28;
    letter-spacing: -0.02em;
  }

  .about-copy .text-link {
    margin-top: 1.8rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-copy:hover .hero-word-studio {
      transform: translateX(0.075em) rotate(-0.25deg);
    }

    .hero-copy:hover .hero-word-wievien {
      transform: translateX(-0.045em) rotate(0.3deg);
      font-style: italic;
    }

    .section-link:hover .section-name,
    .section-link:focus-visible .section-name {
      transform: translateX(0.16em) rotate(-0.35deg);
      font-style: italic;
    }

    .section-link:hover .section-note,
    .section-link:focus-visible .section-note {
      transform: translateX(-0.18em);
      color: var(--ink-soft);
    }

    .project-row:hover strong {
      transform: translateX(0.12em);
    }
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 0.86fr 1.14fr;
      gap: 2.5rem;
    }

    .selection-grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(240px, 0.75fr);
    }
  }

  @media (max-width: 720px) {
    .hero {
      min-height: 0;
      grid-template-columns: 1fr;
      gap: 2.35rem;
      padding-top: 2.5rem;
      padding-bottom: 4.1rem;
    }

    .hero h1 {
      font-size: clamp(4rem, 20vw, 5.5rem);
      line-height: 0.8;
    }

    .hero-fields {
      margin-top: 1.6rem;
      font-size: 0.68rem;
    }

    .hero .quiet-link {
      margin-top: 1.7rem;
    }

    .hero-figure {
      justify-self: stretch;
      width: 100%;
    }

    .hero-figure img {
      aspect-ratio: 4 / 5;
      object-position: 50% 40%;
    }

    .section-index {
      grid-template-columns: 1fr;
      column-gap: 0;
    }

    .section-link {
      min-height: 86px;
      padding-block: 0.95rem;
    }

    .section-name {
      font-size: 1.75rem;
    }

    .section-header,
    .projects-heading,
    .practice-row,
    .about {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .selection-grid {
      grid-template-columns: 1fr;
      gap: 3.2rem;
    }

    .image-frame-landscape {
      aspect-ratio: 4 / 3;
    }

    .selection figcaption {
      grid-template-columns: 1fr;
      gap: 0.14rem;
    }

    .selection figcaption strong,
    .selection figcaption small {
      grid-column: 1;
      justify-self: start;
      text-align: left;
    }

    .fancy-grid {
      grid-template-columns: 1fr;
      gap: 2.6rem;
    }

    .fancy h2 {
      font-size: clamp(3.9rem, 18vw, 5.5rem);
    }

    .fancy-kinetic {
      margin-top: 4rem;
      padding-block: 0.8rem;
    }

    .practice-row {
      padding-block: 2.7rem;
    }

    .project-row {
      grid-template-columns: 54px 1fr;
      gap: 0.25rem 1rem;
    }

    .project-row > span:last-child {
      grid-column: 2;
    }

    .about {
      gap: 1.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fancy-track {
      animation: none;
    }
  }
</style>