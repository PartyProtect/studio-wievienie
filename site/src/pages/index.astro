---
import BaseLayout from '@/layouts/BaseLayout.astro';

const sections = [
  { number: '01', title: 'Werk', note: 'Selectie & projecten', href: '#werk' },
  { number: '02', title: 'Fancy Boogers', note: 'Kledinglijn', href: '#fancy-boogers' },
  { number: '03', title: 'Borduurwerk', note: 'Textiel & detail', href: '#borduurwerk' },
  { number: '04', title: 'Workshops', note: 'Borduren, textiel & upcycling', href: '#workshops' },
];

const projects = [
  { year: '2026', title: 'Carnavalproject', place: 'FASHIONCLASH' },
  { year: '2025', title: 'Studio Wievien bij Juunam', place: 'FASHIONCLASH Festival' },
  { year: '2024', title: 'New Fashion Narratives', place: 'Bureau Europa' },
];

const heroImage = 'https://images.squarespace-cdn.com/content/v1/5bf404ca70e8026f5a085d80/92c0dc63-a0bc-4686-81b0-d0bcc698c06b/Unknown.jpeg';
const juunamImage = 'https://images.squarespace-cdn.com/content/v1/5bf404ca70e8026f5a085d80/1767703456320-YMAS5DUHNMV0VR29ZRLF/MVS_20251120_0093_WEB.jpg';
const projectImage = 'https://images.squarespace-cdn.com/content/v1/5bf404ca70e8026f5a085d80/1772014449994-RK7LCIFVZK23UJQJ4WWS/538A4606_JonathanWiddershoven.jpg';
---

<BaseLayout
  title="Studio Wievien"
  description="Studio Wievien — mode, textiel, borduurwerk, objecten, projecten, workshops en Fancy Boogers."
  lang="nl"
  currentPath="/"
>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Studio Wievien · Maastricht</p>
      <h1 id="hero-title">Mode, textiel en objecten.</h1>
      <p class="hero-lede">
        Studio Wievien is het werk van ontwerper Wievien Alberts: kleding, maskers,
        borduurwerk, projecten en workshops.
      </p>
      <a class="hero-link" href="#werk">Werk bekijken <span aria-hidden="true">↓</span></a>
    </div>

    <figure class="hero-figure">
      <img
        src={heroImage}
        alt="Lichtblauw en lila hoofdobject van Studio Wievien met kralen voor het gezicht"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption>Studio Wievien · via FASHIONCLASH</figcaption>
    </figure>
  </section>

  <nav class="section-index shell" aria-label="Onderdelen van Studio Wievien">
    {sections.map(({ number, title, note, href }) => (
      <a class="section-link" href={href}>
        <span class="section-number">{number}</span>
        <span class="section-name">{title}</span>
        <span class="section-note">{note}</span>
        <span class="section-arrow" aria-hidden="true">↓</span>
      </a>
    ))}
  </nav>

  <section class="selection" id="werk" aria-labelledby="selection-title">
    <div class="shell">
      <header class="section-header">
        <p class="eyebrow">Werk</p>
        <h2 id="selection-title">Selectie</h2>
      </header>

      <div class="selection-grid">
        <figure class="selection-main">
          <div class="image-frame image-frame-landscape">
            <img
              src={juunamImage}
              alt="Presentatie bij Juunam tijdens FASHIONCLASH Festival 2025"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>
            <span>Presentatie</span>
            <strong>Juunam · FASHIONCLASH Festival 2025</strong>
            <small>Foto: Mitch van Schijndel</small>
          </figcaption>
        </figure>

        <figure class="selection-side">
          <div class="image-frame image-frame-portrait">
            <img
              src={projectImage}
              alt="Beeld uit het FASHIONCLASH carnavalproject 2026"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>
            <span>Project</span>
            <strong>Carnavalproject 2026 · FASHIONCLASH</strong>
            <small>Foto: Jonathan Widdershoven</small>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="fancy" id="fancy-boogers" aria-labelledby="fancy-title">
    <div class="shell fancy-grid">
      <div>
        <p class="eyebrow">Kledinglijn</p>
        <h2 id="fancy-title">Fancy<br />Boogers</h2>
      </div>
      <div class="fancy-copy">
        <p>De eigen kledinglijn van Studio Wievien.</p>
        <a
          class="dark-link"
          href="https://www.instagram.com/studio_wievien/"
          rel="noopener noreferrer"
          target="_blank"
        >@studio_wievien <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="practice shell" aria-label="Borduurwerk en workshops">
    <article class="practice-block" id="borduurwerk">
      <p class="eyebrow">Textiel</p>
      <h2>Borduurwerk</h2>
      <p class="practice-intro">Borduurwerk en textielbewerking op kleding en andere dragers.</p>
      <p class="practice-copy">
        Hier komen voorbeelden van werk, technieken en informatie over opdrachten samen.
      </p>
    </article>

    <article class="practice-block" id="workshops">
      <p class="eyebrow">Workshops</p>
      <h2>Samen maken</h2>
      <p class="practice-intro">Workshops rond borduren, textiel en upcycling.</p>
      <p class="practice-copy">
        Nieuwe data, locaties en praktische informatie worden hier geplaatst zodra ze bekend zijn.
      </p>
    </article>
  </section>

  <section class="projects shell" aria-labelledby="projects-title">
    <header class="projects-heading">
      <p class="eyebrow">Projecten & presentaties</p>
      <h2 id="projects-title">2024–2026</h2>
    </header>

    <div class="project-list">
      {projects.map(({ year, title, place }) => (
        <div class="project-row">
          <span class="project-year">{year}</span>
          <strong>{title}</strong>
          <span>{place}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="about" id="over" aria-labelledby="about-title">
    <div class="shell about-grid">
      <div>
        <p class="eyebrow">Over</p>
        <h2 id="about-title">Wievien Alberts</h2>
      </div>
      <div class="about-copy">
        <p>
          Wievien Alberts werkt met kleding, textiel, maskers en objecten. Ze maakt eigen werk,
          werkt aan projecten met anderen en geeft workshops. Maskers keren regelmatig terug in haar werk.
        </p>
        <a
          class="text-link"
          href="https://www.instagram.com/studio_wievien/"
          rel="noopener noreferrer"
          target="_blank"
        >Instagram</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: calc(100svh - 70px);
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(360px, 1.1fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 5.5rem);
  }

  .hero-copy {
    max-width: 600px;
  }

  .hero h1 {
    margin-top: 1rem;
    max-width: 8ch;
    font-size: clamp(3.5rem, 7.2vw, 7.4rem);
    line-height: 0.88;
  }

  .hero-lede {
    margin-top: 1.8rem;
    max-width: 36rem;
    color: var(--text-mid);
    font-size: clamp(1rem, 1.45vw, 1.18rem);
    line-height: 1.55;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 2.4rem;
    padding: 0.78rem 1rem;
    border: 1px solid var(--text);
    font-size: 0.82rem;
    font-weight: 650;
    text-decoration: none;
    transition: background 180ms var(--ease), color 180ms var(--ease);
  }

  .hero-link:hover,
  .hero-link:focus-visible {
    background: var(--text);
    color: var(--bg);
  }

  .hero-figure {
    justify-self: end;
    width: min(100%, 650px);
  }

  .hero-figure img {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 39%;
    background: #f8f8f6;
  }

  .hero-figure figcaption {
    margin-top: 0.55rem;
    color: var(--text-light);
    font-size: 0.68rem;
  }

  .section-index {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-bottom: var(--section);
    border-top: 1px solid var(--border-dark);
    border-left: 1px solid var(--border-dark);
  }

  .section-link {
    min-height: 150px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-rows: auto 1fr;
    gap: 0.75rem 1.2rem;
    padding: clamp(1.1rem, 2.4vw, 1.8rem);
    border-right: 1px solid var(--border-dark);
    border-bottom: 1px solid var(--border-dark);
    text-decoration: none;
    transition: background 180ms var(--ease);
  }

  .section-link:hover,
  .section-link:focus-visible {
    background: var(--accent-soft);
  }

  .section-number {
    font-size: 0.68rem;
    color: var(--text-light);
  }

  .section-name {
    align-self: end;
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3.2vw, 3rem);
    line-height: 1;
  }

  .section-note {
    grid-column: 2;
    color: var(--text-mid);
    font-size: 0.78rem;
  }

  .section-arrow {
    grid-row: 1 / 3;
    grid-column: 3;
    align-self: end;
    font-size: 1rem;
  }

  .selection {
    padding-block: var(--section);
    background: #ece9e3;
  }

  .section-header {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    align-items: end;
    margin-bottom: clamp(2.2rem, 5vw, 4rem);
  }

  .section-header h2,
  .practice h2,
  .projects h2,
  .about h2 {
    font-size: clamp(2.5rem, 5vw, 5rem);
    line-height: 0.94;
  }

  .selection-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(280px, 0.72fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    align-items: start;
  }

  .image-frame {
    overflow: hidden;
    background: var(--bg-soft);
  }

  .image-frame img {
    height: 100%;
    object-fit: cover;
    transition: transform 420ms var(--ease);
  }

  figure:hover .image-frame img {
    transform: scale(1.012);
  }

  .image-frame-landscape {
    aspect-ratio: 3 / 2;
  }

  .image-frame-portrait {
    aspect-ratio: 4 / 5;
  }

  .selection figcaption {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 1rem;
    padding-top: 0.7rem;
  }

  .selection figcaption span {
    color: var(--text-light);
    font-size: 0.67rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }

  .selection figcaption strong {
    justify-self: end;
    text-align: right;
    font-size: 0.78rem;
    font-weight: 650;
  }

  .selection figcaption small {
    grid-column: 2;
    justify-self: end;
    color: var(--text-light);
    font-size: 0.65rem;
  }

  .fancy {
    padding-block: clamp(5rem, 11vw, 10rem);
    background: var(--bg-ink);
    color: var(--text-on-dark);
  }

  .fancy .eyebrow {
    color: #99958f;
  }

  .fancy-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(260px, 0.65fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
  }

  .fancy h2 {
    margin-top: 0.8rem;
    font-size: clamp(4rem, 10vw, 10rem);
    line-height: 0.76;
    letter-spacing: -0.055em;
  }

  .fancy-copy {
    padding-bottom: 0.4rem;
  }

  .fancy-copy p {
    max-width: 24rem;
    color: #c6c1ba;
    font-size: clamp(1.05rem, 1.5vw, 1.22rem);
  }

  .dark-link {
    display: inline-flex;
    gap: 0.45rem;
    margin-top: 1.8rem;
    padding-bottom: 0.14rem;
    border-bottom: 1px solid #77736d;
    color: var(--text-on-dark);
    font-size: 0.84rem;
    text-decoration: none;
  }

  .practice {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding-block: var(--section);
  }

  .practice-block {
    padding: clamp(1rem, 3vw, 2.5rem) clamp(1.5rem, 5vw, 4.5rem) clamp(1rem, 3vw, 2.5rem) 0;
  }

  .practice-block + .practice-block {
    padding-left: clamp(1.5rem, 5vw, 4.5rem);
    padding-right: 0;
    border-left: 1px solid var(--border-dark);
  }

  .practice h2 {
    margin-top: 0.8rem;
  }

  .practice-intro {
    margin-top: clamp(2rem, 5vw, 4.5rem);
    max-width: 22ch;
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.6vw, 2.35rem);
    line-height: 1.12;
  }

  .practice-copy {
    margin-top: 1.2rem;
    max-width: 34rem;
    color: var(--text-mid);
  }

  .projects {
    padding-block: var(--section);
    border-top: 1px solid var(--border-dark);
  }

  .projects-heading {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    align-items: end;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  .project-list {
    border-top: 1px solid var(--border-dark);
  }

  .project-row {
    display: grid;
    grid-template-columns: 100px minmax(0, 1.35fr) minmax(180px, 0.65fr);
    gap: 1rem;
    align-items: baseline;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .project-row strong {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2vw, 1.8rem);
    font-weight: 400;
  }

  .project-year,
  .project-row > span:last-child {
    color: var(--text-mid);
    font-size: 0.78rem;
  }

  .about {
    padding-block: var(--section);
    background: var(--accent-soft);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }

  .about h2 {
    margin-top: 0.8rem;
  }

  .about-copy {
    padding-top: 1.5rem;
  }

  .about-copy p {
    max-width: 38rem;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.6;
  }

  .about-copy .text-link {
    margin-top: 1.8rem;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .hero h1 {
      font-size: clamp(3.3rem, 8vw, 5.2rem);
    }

    .selection-grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(240px, 0.75fr);
    }
  }

  @media (max-width: 720px) {
    .hero {
      min-height: 0;
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-top: 2rem;
      padding-bottom: 3.5rem;
    }

    .hero-copy {
      order: 1;
    }

    .hero-figure {
      order: 2;
      justify-self: stretch;
      width: 100%;
    }

    .hero h1 {
      max-width: 9ch;
      font-size: clamp(3.2rem, 16vw, 5.4rem);
    }

    .hero-lede {
      margin-top: 1.25rem;
    }

    .hero-link {
      margin-top: 1.6rem;
    }

    .hero-figure img {
      aspect-ratio: 4 / 5;
    }

    .section-index {
      grid-template-columns: 1fr;
      margin-bottom: var(--section);
    }

    .section-link {
      min-height: 105px;
      grid-template-columns: 34px 1fr auto;
      align-items: center;
      padding: 1rem;
    }

    .section-name {
      align-self: center;
      font-size: 1.75rem;
    }

    .section-note {
      grid-column: 2;
    }

    .section-arrow {
      align-self: center;
    }

    .section-header,
    .projects-heading {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }

    .selection-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .image-frame-landscape {
      aspect-ratio: 4 / 3;
    }

    .selection-side {
      width: 78%;
      margin-left: auto;
    }

    .selection figcaption {
      grid-template-columns: 1fr;
    }

    .selection figcaption strong,
    .selection figcaption small {
      grid-column: 1;
      justify-self: start;
      text-align: left;
    }

    .fancy-grid,
    .practice,
    .about-grid {
      grid-template-columns: 1fr;
    }

    .fancy-grid {
      gap: 3rem;
    }

    .fancy h2 {
      font-size: clamp(4.4rem, 24vw, 7rem);
    }

    .practice-block,
    .practice-block + .practice-block {
      padding: 0 0 3.5rem;
    }

    .practice-block + .practice-block {
      padding-top: 3.5rem;
      border-left: 0;
      border-top: 1px solid var(--border-dark);
    }

    .practice-intro {
      margin-top: 2rem;
    }

    .project-row {
      grid-template-columns: 58px 1fr;
      gap: 0.35rem 1rem;
    }

    .project-row > span:last-child {
      grid-column: 2;
    }

    .about-grid {
      gap: 1.5rem;
    }

    .about-copy {
      padding-top: 0;
    }
  }

  @media (max-width: 420px) {
    .selection-side {
      width: 88%;
    }
  }
</style>
