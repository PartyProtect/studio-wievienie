  :global(html[data-assembly='playing']) .crew-question-supervisor { animation: question-pop 1080ms 2840ms var(--ease) both; }
  :global(html[data-assembly='playing']) .crew-supervisor-point-arm { animation: supervisor-point 1180ms 3520ms var(--ease) both; }
  :global(html[data-assembly='playing']) .crew-rope-cast { animation: rope-cast 860ms 3980ms ease-out both; }
  :global(html[data-assembly='playing']) .crew-rope-taut {
