    21% {
      transform: translateY(-0.45px);
    }
    41% {
      transform: translateY(1px);
    }
    49% {
      transform: translateY(-0.55px);
    }
    69% {
      transform: translateY(0.85px);
    }
    78% {
      transform: translateY(-0.4px);
    }
  }

  @media (max-width: 720px) {
