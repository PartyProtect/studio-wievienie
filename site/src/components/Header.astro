---
interface Props {
  lang?: 'nl' | 'en';
  currentPath?: string;
}

const { lang = 'nl', currentPath = '' } = Astro.props;

const nav = lang === 'nl'
  ? [
      { href: '/werk/', label: 'Werk' },
      { href: '/fancy-boogers/', label: 'Fancy Boogers' },
      { href: '/#borduurwerk', label: 'Borduurwerk' },
      { href: '/#workshops', label: 'Workshops' },
      { href: '/#over', label: 'Over' },
    ]
  : [
      { href: '/werk/', label: 'Work' },
      { href: '/fancy-boogers/', label: 'Fancy Boogers' },
      { href: '/#borduurwerk', label: 'Embroidery' },
      { href: '/#workshops', label: 'Workshops' },
      { href: '/#over', label: 'About' },
    ];
---

<header class="site-header">
  <div class="shell header-inner">
    <a href="/" class="brand" aria-label="Studio Wievien home">Studio Wievien</a>

    <nav class="desktop-nav" aria-label={lang === 'nl' ? 'Hoofdnavigatie' : 'Main navigation'}>
      {nav.map(({ href, label }) => (
        <a href={href} aria-current={currentPath.startsWith(href) ? 'page' : undefined}>{label}</a>
      ))}
    </nav>

    <a
      class="instagram desktop-instagram"
      href="https://www.instagram.com/studio_wievien/"
      rel="noopener noreferrer"
      target="_blank"
    >Instagram ↗</a>

    <details class="mobile-menu">
      <summary>Menu</summary>
      <div class="mobile-panel">
        <nav aria-label={lang === 'nl' ? 'Mobiele navigatie' : 'Mobile navigation'}>
          {nav.map(({ href, label }) => (
            <a href={href} aria-current={currentPath.startsWith(href) ? 'page' : undefined}>{label}</a>
          ))}
          <a
            href="https://www.instagram.com/studio_wievien/"
            rel="noopener noreferrer"
            target="_blank"
          >Instagram ↗</a>
        </nav>
      </div>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector('.mobile-menu');

  if (menu instanceof HTMLDetailsElement) {
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => menu.removeAttribute('open'));
    });

    const closeWhenDesktop = () => {
      if (window.innerWidth > 850) menu.removeAttribute('open');
    };

    window.addEventListener('resize', closeWhenDesktop, { passive: true });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 96%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .header-inner {
    min-height: 64px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem;
  }

  .brand {
    font-family: var(--font-display);
    font-size: 1.13rem;
    letter-spacing: -0.03em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .desktop-nav {
    display: flex;
    justify-content: center;
    gap: clamp(1rem, 2.2vw, 2rem);
  }

  .desktop-nav a,
  .instagram {
    color: var(--ink-soft);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.015em;
    text-decoration: none;
    transition: color 160ms var(--ease);
  }

  .desktop-nav a:hover,
  .desktop-nav a:focus-visible,
  .instagram:hover,
  .instagram:focus-visible,
  .desktop-nav a[aria-current='page'] {
    color: var(--ink);
  }

  .desktop-nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
  }

  .mobile-menu {
    display: none;
    position: relative;
  }

  .mobile-menu summary {
    list-style: none;
    cursor: pointer;
    color: var(--ink-soft);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-panel {
    position: fixed;
    top: 60px;
    left: 0;
    right: 0;
    background: var(--bg);
    border-bottom: 1px solid var(--line-strong);
    padding: 0.75rem var(--gutter) 1.25rem;
  }

  .mobile-panel nav {
    display: grid;
  }

  .mobile-panel a {
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 1.55rem;
    line-height: 1;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .mobile-panel a[aria-current='page'] {
    font-style: italic;
  }

  .mobile-panel a:last-child {
    border-bottom: 0;
  }

  @media (max-width: 850px) {
    .header-inner {
      grid-template-columns: 1fr auto;
      min-height: 60px;
    }

    .desktop-nav,
    .desktop-instagram {
      display: none;
    }

    .mobile-menu {
      display: block;
    }
  }
</style>
