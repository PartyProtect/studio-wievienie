---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AssemblyCrew from '@/components/AssemblyCrew.astro';
import { heroWork, homepageProjects, homepageWork } from '@/data/content';
import '@/styles/homepage.css';

const [juunamWork, carnivalWork] = homepageWork;
---

<BaseLayout
  title="Studio Wievien"
  description="Studio Wievien — mode, textiel, borduurwerk, objecten, projecten, workshops en Fancy Boogers."
  lang="nl"
  currentPath="/"
  ogImage={heroWork.image}
  firstVisitAssembly
>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow" data-assemble="eyebrow">Wievien Alberts · Maastricht</p>
      <div class="hero-title-stage">
        <h1 id="hero-title">
          <span class="hero-word hero-word-studio" data-assemble="studio">Studio</span>
          <span class="hero-word hero-word-wievien" data-assemble="wievien">Wievien</span>
        </h1>
        <AssemblyCrew />
      </div>
      <p class="hero-fields" data-assemble="fields">Mode · textiel · objecten · workshops</p>
      <a class="quiet-link" href="/werk/" data-assemble="cta">Werk <span aria-hidden="true">→</span></a>
    </div>

    <figure class="hero-figure" data-assemble="image">
      <div class="assembly-guides" data-assemble="guides" aria-hidden="true">
        <span class="assembly-guide assembly-guide-top"></span>
        <span class="assembly-guide assembly-guide-right"></span>
        <span class="assembly-guide assembly-guide-cross"></span>
      </div>

      <div class="hero-image-frame">
        <img
          src={heroWork.image}
          alt={heroWork.alt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <figcaption data-assemble="caption">
        <span>{heroWork.context}</span>
        <span>{heroWork.credit}</span>
      </figcaption>
    </figure>
  </section>

  <section class="selection" id="werk" aria-labelledby="selection-title">
    <div class="shell">
      <header class="section-header">
        <p class="eyebrow">Werk</p>
        <h2 id="selection-title">Selectie</h2>
      </header>

      <div class="selection-grid">
        <figure class="selection-main">
          <div class="image-frame image-frame-landscape">
            <img
              src={juunamWork.image}
              alt={juunamWork.alt}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>
            <span>{juunamWork.category}</span>
            <strong>{juunamWork.title} · {juunamWork.context} {juunamWork.year}</strong>
            <small>{juunamWork.credit}</small>
          </figcaption>
        </figure>

        <figure class="selection-side">
          <div class="image-frame image-frame-portrait">
            <img
              src={carnivalWork.image}
              alt={carnivalWork.alt}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>
            <span>{carnivalWork.category}</span>
            <strong>{carnivalWork.title} · {carnivalWork.context} {carnivalWork.year}</strong>
            <small>{carnivalWork.credit}</small>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="fancy" id="fancy-boogers" aria-labelledby="fancy-title">
    <div class="shell fancy-grid">
      <div>
        <p class="eyebrow">Kledinglijn · Studio Wievien</p>
        <h2 id="fancy-title">Fancy Boogers</h2>
      </div>
      <div class="fancy-copy">
        <p>Eigen kledinglijn van Wievien Alberts.</p>
        <p class="fancy-meta">In 2026 verscheen werk uit de collectie op de cover van ECOPOLITAN #7.</p>
        <a
          class="dark-link"
          href="https://www.instagram.com/studio_wievien/"
          rel="noopener noreferrer"
          target="_blank"
        >@studio_wievien <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <div class="fancy-kinetic" aria-hidden="true">
      <div class="fancy-track">
        <span>Fancy Boogers · Studio Wievien · kleding · textiel · </span>
        <span>Fancy Boogers · Studio Wievien · kleding · textiel · </span>
        <span>Fancy Boogers · Studio Wievien · kleding · textiel · </span>
        <span>Fancy Boogers · Studio Wievien · kleding · textiel · </span>
      </div>
    </div>
  </section>

  <section class="practice shell" aria-label="Borduurwerk en workshops">
    <article class="practice-row" id="borduurwerk">
      <div class="practice-title">
        <p class="eyebrow">Textiel</p>
        <h2>Borduurwerk</h2>
      </div>
      <div class="practice-copy">
        <p>Borduurwerk en textielbewerking op kleding en andere dragers.</p>
        <small>Werk · technieken · opdrachten</small>
      </div>
    </article>

    <article class="practice-row" id="workshops">
      <div class="practice-title">
        <p class="eyebrow">Workshops</p>
        <h2>Samen maken</h2>
      </div>
      <div class="practice-copy">
        <p>Workshops rond borduren, textiel en upcycling.</p>
        <small>Studio Wievien · Maastricht</small>
      </div>
    </article>
  </section>

  <section class="projects shell" aria-labelledby="projects-title">
    <header class="projects-heading">
      <p class="eyebrow">Projecten & presentaties</p>
      <h2 id="projects-title">2024–2026</h2>
    </header>

    <div class="project-list">
      {homepageProjects.map(({ year, title, place }) => (
        <div class="project-row">
          <span class="project-year">{year}</span>
          <strong>{title}</strong>
          <span>{place}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="about shell" id="over" aria-labelledby="about-title">
    <div class="about-heading">
      <p class="eyebrow">Over</p>
      <h2 id="about-title">Wievien Alberts</h2>
    </div>
    <div class="about-copy">
      <p>Ik ben Wievien en ik hou van kleding. Soms is het zo simpel.</p>
      <a
        class="text-link"
        href="https://www.instagram.com/studio_wievien/"
        rel="noopener noreferrer"
        target="_blank"
      >Instagram ↗</a>
    </div>
  </section>
</BaseLayout>
