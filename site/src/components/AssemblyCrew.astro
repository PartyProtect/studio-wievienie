  :global(html[data-assembly='playing'] [data-assemble='door']:nth-child(2)) { animation-delay: 8570ms !important; }
  :global(html[data-assembly='playing'] [data-assemble='door']:nth-child(3)) { animation-delay: 8740ms !important; }
  :global(html[data-assembly='playing'] [data-assemble='door']:nth-child(4)) { animation-delay: 8910ms !important; }

