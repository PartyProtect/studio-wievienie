      transform: rotate(-11deg) translateX(-2px);
    }
    18% {
      transform: rotate(-17deg) translateX(-5px);
    }
    24% {
      transform: rotate(-9deg) translateX(-1px);
    }
    39% {
      transform: rotate(-19deg) translateX(-6px);
    }
    47% {
      transform: rotate(-11deg) translateX(-2px);
    }
    64% {
      transform: rotate(-20deg) translateX(-7px);
    }
    72% {
      transform: rotate(-12deg) translateX(-2px);
    }
