---
interface Props {
  lang?: 'nl' | 'en';
}

const { lang = 'nl' } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <div class="footer-top">
      <div>
        <p class="footer-brand">Studio Wievien</p>
        <p class="footer-note">
          {lang === 'nl'
            ? 'Mode · textiel · objecten · workshops'
            : 'Fashion · textiles · objects · workshops'}
        </p>
      </div>

      <nav aria-label={lang === 'nl' ? 'Footer navigatie' : 'Footer navigation'}>
        <a href="/#werk">{lang === 'nl' ? 'Werk' : 'Work'}</a>
        <a href="/#fancy-boogers">Fancy Boogers</a>
        <a href="/#workshops">Workshops</a>
        <a href="/#over">{lang === 'nl' ? 'Over' : 'About'}</a>
      </nav>

      <a
        class="footer-instagram"
        href="https://www.instagram.com/studio_wievien/"
        rel="noopener noreferrer"
        target="_blank"
      >@studio_wievien ↗</a>
    </div>

    <div class="footer-bottom">
      <span>© {currentYear} Studio Wievien</span>
      <span>Maastricht</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-ink);
    color: var(--text-on-dark);
  }

  .footer-inner {
    padding-block: clamp(3rem, 6vw, 5rem) 1.3rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: start;
    gap: clamp(2rem, 6vw, 6rem);
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  .footer-brand {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3vw, 3rem);
    line-height: 1;
  }

  .footer-note {
    margin-top: 0.7rem;
    color: #aaa59d;
    font-size: 0.76rem;
  }

  nav {
    display: grid;
    gap: 0.5rem;
  }

  nav a,
  .footer-instagram {
    color: #d7d1c8;
    font-size: 0.82rem;
    text-decoration: none;
  }

  nav a:hover,
  nav a:focus-visible,
  .footer-instagram:hover,
  .footer-instagram:focus-visible {
    color: white;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 1rem;
    border-top: 1px solid #383633;
    color: #88837d;
    font-size: 0.68rem;
  }

  @media (max-width: 720px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 2.2rem;
    }
  }
</style>
