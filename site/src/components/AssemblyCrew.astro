<div class="letter-entrance" aria-hidden="true"></div>

<style>
  :global(html[data-assembly='pending'] [data-assemble='wievien']),
  :global(html[data-assembly='playing'] [data-assemble='wievien']) {
    visibility: hidden !important;
    opacity: 1 !important;
  }

  :global(html[data-assembly='playing'] [data-assemble='wievien'][data-letter-entrance='complete']) {
    visibility: visible !important;
  }

  :global([data-assemble='wievien']) {
    text-shadow: 0 0.035em 0.08em rgb(23 23 22 / 0.12);
  }

  :global(.kinetic-word-layer) {
    position: fixed;
    z-index: 42;
    overflow: visible;
    pointer-events: none;
    contain: layout style;
  }

  :global(.kinetic-glyph),
  :global(.kinetic-glyph-shadow) {
    position: absolute;
    inset: 0;
    will-change: transform, opacity;
  }

  :global(.kinetic-glyph) {
    overflow: visible;
    transform-origin: center bottom;
  }

  :global(.kinetic-glyph-ink) {
    position: absolute;
    inset: 0;
    display: block;
    white-space: nowrap;
    color: var(--ink);
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  :global(.kinetic-glyph-shadow) {
    inset: auto;
    height: 5px;
    border-radius: 50%;
    background: rgb(23 23 22 / 0.24);
    filter: blur(5px);
    transform-origin: center;
    opacity: 0;
  }

  :global(html[data-assembly='playing'] [data-assemble='image'] .hero-image-frame),
  :global(html[data-assembly='playing'] [data-assemble='image'] .hero-image-frame img) {
    animation-delay: 5700ms !important;
  }

  :global(html[data-assembly='playing'] [data-assemble='guides']) { animation-delay: 5550ms !important; }
  :global(html[data-assembly='playing'] [data-assemble='guides'] .assembly-guide-top) { animation-delay: 5580ms !important; }
  :global(html[data-assembly='playing'] [data-assemble='guides'] .assembly-guide-right) { animation-delay: 5760ms !important; }
  :global(html[data-assembly='playing'] [data-assemble='guides'] .assembly-guide-cross) { animation-delay: 5940ms !important; }
  :global(html[data-assembly='playing'] [data-assemble='fields']) { animation-delay: 5950ms !important; }
  :global(html[data-assembly='playing'] [data-assemble='cta']) { animation-delay: 6180ms !important; }
  :global(html[data-assembly='playing'] [data-assemble='caption']) { animation-delay: 6200ms !important; }
  :global(html[data-assembly='playing'] [data-assemble='index']) { animation-delay: 6360ms !important; }
  :global(html[data-assembly='playing'] [data-assemble='door']:nth-child(1)) { animation-delay: 6480ms !important; }
  :global(html[data-assembly='playing'] [data-assemble='door']:nth-child(2)) { animation-delay: 6600ms !important; }
  :global(html[data-assembly='playing'] [data-assemble='door']:nth-child(3)) { animation-delay: 6720ms !important; }
  :global(html[data-assembly='playing'] [data-assemble='door']:nth-child(4)) { animation-delay: 6840ms !important; }

  @media (prefers-reduced-motion: reduce) {
    :global(.kinetic-word-layer) { display: none !important; }
    :global([data-assemble='wievien']) { visibility: visible !important; }
  }
</style>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const source = document.querySelector('[data-assemble="wievien"]');
    if (!source) return;

    let started = false;

    const waitForPlay = () => {
      if (root.dataset.assembly === 'playing') {
        start();
        return;
      }

      const observer = new MutationObserver(() => {
        if (root.dataset.assembly === 'playing') {
          observer.disconnect();
          start();
        }
      });

      observer.observe(root, { attributes: true, attributeFilter: ['data-assembly'] });
    };

    const start = async () => {
      if (started) return;
      started = true;

      try {
        if (document.fonts?.ready) await document.fonts.ready;
        if (root.dataset.assembly !== 'playing') return;

        const textNode = Array.from(source.childNodes).find((node) => node.nodeType === Node.TEXT_NODE);
        const word = source.textContent?.trim() || '';
        if (!textNode || word !== 'Wievien') return;

        source.style.animation = 'none';
        source.style.transform = 'none';
        source.style.transition = 'none';

        const sourceRect = source.getBoundingClientRect();
        const computed = getComputedStyle(source);
        const layer = document.createElement('div');
        layer.className = 'kinetic-word-layer';
        Object.assign(layer.style, {
          left: `${sourceRect.left}px`,
          top: `${sourceRect.top}px`,
          width: `${sourceRect.width}px`,
          height: `${sourceRect.height}px`,
        });

        const glyphs = [];
        const shadows = [];

        for (let index = 0; index < word.length; index += 1) {
          const range = document.createRange();
          range.setStart(textNode, index);
          range.setEnd(textNode, index + 1);
          const rect = range.getBoundingClientRect();
          range.detach?.();

          const left = rect.left - sourceRect.left;
          const top = rect.top - sourceRect.top;
          const right = sourceRect.right - rect.right;
          const bottom = sourceRect.bottom - rect.bottom;

          const glyph = document.createElement('div');
          glyph.className = `kinetic-glyph kinetic-glyph-${index}`;
          glyph.style.transformOrigin = `${left + rect.width / 2}px ${top + rect.height}px`;

          const ink = document.createElement('span');
          ink.className = 'kinetic-glyph-ink';
          ink.textContent = word;
          Object.assign(ink.style, {
            fontFamily: computed.fontFamily,
            fontSize: computed.fontSize,
            fontWeight: computed.fontWeight,
            fontStyle: computed.fontStyle,
            fontStretch: computed.fontStretch,
            fontVariant: computed.fontVariant,
            fontKerning: computed.fontKerning,
            fontFeatureSettings: computed.fontFeatureSettings,
            fontVariationSettings: computed.fontVariationSettings,
            lineHeight: computed.lineHeight,
            letterSpacing: computed.letterSpacing,
            clipPath: `inset(${Math.max(0, top - 1)}px ${Math.max(0, right - 1)}px ${Math.max(0, bottom - 1)}px ${Math.max(0, left - 1)}px)`,
            textShadow: '0 0.035em 0.08em rgb(23 23 22 / 0.13)',
          });
          glyph.appendChild(ink);

          const shadow = document.createElement('div');
          shadow.className = `kinetic-glyph-shadow kinetic-glyph-shadow-${index}`;
          Object.assign(shadow.style, {
            left: `${left + rect.width * 0.08}px`,
            top: `${Math.min(sourceRect.height - 3, top + rect.height - 4)}px`,
            width: `${Math.max(7, rect.width * 0.84)}px`,
          });

          layer.appendChild(shadow);
          layer.appendChild(glyph);
          glyphs.push(glyph);
          shadows.push(shadow);
        }

        document.body.appendChild(layer);
        source.style.animation = '';
        source.style.transform = '';
        source.style.transition = '';

        const sequences = [
          {
            delay: 320,
            duration: 1680,
            easing: 'cubic-bezier(.2,.75,.2,1)',
            frames: [
              { offset: 0, transform: 'translate(-58vw, 1vh) rotate(-13deg) scale(.94)' },
              { offset: .15, transform: 'translate(-47vw, -1.2vh) rotate(8deg) scale(.97)' },
              { offset: .29, transform: 'translate(-36vw, .6vh) rotate(-8deg) scale(.975)' },
              { offset: .43, transform: 'translate(-25vw, -1vh) rotate(7deg) scale(.985)' },
              { offset: .58, transform: 'translate(-15vw, .45vh) rotate(-5deg) scale(.99)' },
              { offset: .73, transform: 'translate(-7vw, -.6vh) rotate(3.5deg) scale(.997)' },
              { offset: .87, transform: 'translate(-1.2vw, 0) rotate(-1deg) scale(1.01, .96)' },
              { offset: 1, transform: 'none' },
            ],
            shadow: [
              { offset: 0, transform: 'translateX(-58vw) scale(1.55,.62)', opacity: .11 },
              { offset: .43, transform: 'translateX(-25vw) scale(1.25,.72)', opacity: .17 },
              { offset: .73, transform: 'translateX(-7vw) scale(1.05,.82)', opacity: .22 },
              { offset: .87, transform: 'translateX(-1.2vw) scale(1.28,.52)', opacity: .28 },
              { offset: 1, transform: 'none', opacity: .18 },
            ],
          },
          {
            delay: 1910,
            duration: 640,
            easing: 'cubic-bezier(.16,.9,.22,1)',
            frames: [
              { offset: 0, transform: 'translate(-11vw, -52vh) rotate(-190deg) scale(.68)' },
              { offset: .6, transform: 'translate(1.8vw, -3vh) rotate(18deg) scale(1.05)' },
              { offset: .78, transform: 'translate(1.1vw, .2vh) rotate(6deg) scale(1.12,.86)' },
              { offset: 1, transform: 'none' },
            ],
            shadow: [
              { offset: 0, transform: 'translateX(-11vw) scale(.28,.45)', opacity: .05 },
              { offset: .58, transform: 'translateX(1.8vw) scale(.55,.6)', opacity: .11 },
              { offset: .78, transform: 'translateX(1.1vw) scale(1.35,.42)', opacity: .28 },
              { offset: 1, transform: 'none', opacity: .18 },
            ],
          },
          {
            delay: 2200,
            duration: 920,
            easing: 'cubic-bezier(.2,.72,.18,1)',
            frames: [
              { offset: 0, transform: 'translate(-32vw, -12vh) rotate(-560deg) scale(.82)' },
              { offset: .42, transform: 'translate(-17vw, -25vh) rotate(-315deg) scale(.92)' },
              { offset: .72, transform: 'translate(-3vw, -5vh) rotate(-60deg) scale(1)' },
              { offset: .88, transform: 'translate(.7vw, .4vh) rotate(12deg) scale(1.04,.93)' },
              { offset: 1, transform: 'none' },
            ],
            shadow: [
              { offset: 0, transform: 'translateX(-32vw) scale(.45,.55)', opacity: .08 },
              { offset: .42, transform: 'translateX(-17vw) scale(.35,.45)', opacity: .06 },
              { offset: .72, transform: 'translateX(-3vw) scale(.7,.62)', opacity: .14 },
              { offset: .88, transform: 'translateX(.7vw) scale(1.28,.48)', opacity: .27 },
              { offset: 1, transform: 'none', opacity: .18 },
            ],
          },
          {
            delay: 3160,
            duration: 980,
            easing: 'cubic-bezier(.16,.82,.25,1)',
            frames: [
              { offset: 0, transform: 'translate(0, -67vh) rotate(30deg) scale(.86)' },
              { offset: .64, transform: 'translate(0, 1.2vh) rotate(-5deg) scale(1.04,.76)' },
              { offset: .78, transform: 'translate(0, -5.5vh) rotate(2deg) scale(.98,1.05)' },
              { offset: .9, transform: 'translate(0, .25vh) rotate(-1deg) scale(1.02,.92)' },
              { offset: 1, transform: 'none' },
            ],
            shadow: [
              { offset: 0, transform: 'scale(.18,.35)', opacity: .035 },
              { offset: .45, transform: 'scale(.38,.48)', opacity: .07 },
              { offset: .64, transform: 'scale(1.55,.38)', opacity: .31 },
              { offset: .78, transform: 'scale(.58,.64)', opacity: .12 },
              { offset: .9, transform: 'scale(1.25,.45)', opacity: .27 },
              { offset: 1, transform: 'none', opacity: .18 },
            ],
          },
          {
            delay: 4250,
            duration: 620,
            easing: 'cubic-bezier(.17,.86,.25,1)',
            frames: [
              { offset: 0, transform: 'translate(8vw, 37vh) rotate(185deg) scale(.72)' },
              { offset: .62, transform: 'translate(-.8vw, -5vh) rotate(-18deg) scale(1.04)' },
              { offset: .83, transform: 'translate(.35vw, .25vh) rotate(5deg) scale(1.08,.88)' },
              { offset: 1, transform: 'none' },
            ],
            shadow: [
              { offset: 0, transform: 'translateX(8vw) scale(.28,.42)', opacity: .06 },
              { offset: .62, transform: 'translateX(-.8vw) scale(.58,.6)', opacity: .12 },
              { offset: .83, transform: 'translateX(.35vw) scale(1.38,.4)', opacity: .29 },
              { offset: 1, transform: 'none', opacity: .18 },
            ],
          },
          {
            delay: 4460,
            duration: 860,
            easing: 'cubic-bezier(.2,.78,.2,1)',
            frames: [
              { offset: 0, transform: 'translate(24vw, -29vh) rotate(120deg) scale(.82)' },
              { offset: .4, transform: 'translate(12vw, -18vh) rotate(58deg) scale(.94)' },
              { offset: .72, transform: 'translate(2vw, -3vh) rotate(10deg) scale(1.01)' },
              { offset: .88, transform: 'translate(-.55vw, .3vh) rotate(-7deg) scale(1.04,.93)' },
              { offset: 1, transform: 'none' },
            ],
            shadow: [
              { offset: 0, transform: 'translateX(24vw) scale(.35,.48)', opacity: .06 },
              { offset: .4, transform: 'translateX(12vw) scale(.42,.52)', opacity: .08 },
              { offset: .72, transform: 'translateX(2vw) scale(.72,.64)', opacity: .14 },
              { offset: .88, transform: 'translateX(-.55vw) scale(1.25,.46)', opacity: .27 },
              { offset: 1, transform: 'none', opacity: .18 },
            ],
          },
          {
            delay: 4860,
            duration: 920,
            easing: 'cubic-bezier(.1,.76,.18,1)',
            frames: [
              { offset: 0, transform: 'translate(58vw, 0) rotate(8deg) skewX(-8deg) scale(1.05)' },
              { offset: .56, transform: 'translate(-2.4vw, 0) rotate(-2deg) skewX(2deg) scale(1.04,.96)' },
              { offset: .74, transform: 'translate(1.5vw, 0) rotate(.8deg) skewX(-1deg)' },
              { offset: .9, transform: 'translate(-.35vw, 0) rotate(-.3deg)' },
              { offset: 1, transform: 'none' },
            ],
            shadow: [
              { offset: 0, transform: 'translateX(58vw) scale(2.3,.38)', opacity: .1 },
              { offset: .56, transform: 'translateX(-2.4vw) scale(2.15,.36)', opacity: .28 },
              { offset: .74, transform: 'translateX(1.5vw) scale(1.55,.44)', opacity: .25 },
              { offset: .9, transform: 'translateX(-.35vw) scale(1.18,.55)', opacity: .21 },
              { offset: 1, transform: 'none', opacity: .18 },
            ],
          },
        ];

        glyphs.forEach((glyph, index) => {
          const sequence = sequences[index];
          glyph.animate(sequence.frames, {
            duration: sequence.duration,
            delay: sequence.delay,
            easing: sequence.easing,
            fill: 'both',
          });

          shadows[index].animate(sequence.shadow, {
            duration: sequence.duration,
            delay: sequence.delay,
            easing: sequence.easing,
            fill: 'both',
          });
        });

        window.setTimeout(() => {
          source.dataset.letterEntrance = 'complete';
          source.animate([
            { transform: 'translateY(-2px)', textShadow: '0 0.08em 0.14em rgb(23 23 22 / 0.22)' },
            { transform: 'translateY(0)', textShadow: '0 0.035em 0.08em rgb(23 23 22 / 0.12)' },
          ], { duration: 240, easing: 'cubic-bezier(.2,.8,.2,1)', fill: 'both' });

          layer.animate([{ opacity: 1 }, { opacity: 0 }], {
            duration: 180,
            easing: 'ease-out',
            fill: 'forwards',
          }).finished.then(() => layer.remove());
        }, 5900);
      } catch {
        source.dataset.letterEntrance = 'complete';
      }
    };

    waitForPlay();
  })();
</script>
