---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: 'nl' | 'en';
  currentPath?: string;
  ogImage?: string;
  noindex?: boolean;
  hideChrome?: boolean;
  themeColor?: string;
}

const {
  title,
  description,
  lang = 'nl',
  currentPath = '',
  ogImage,
  noindex = false,
  hideChrome = false,
  themeColor = '#f6f4ef',
} = Astro.props;

const fullTitle = title === 'Studio Wievien' ? title : `${title} — Studio Wievien`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://studiowievien.nl');
const ogImageURL = ogImage ? new URL(ogImage, canonicalURL).href : undefined;
const skipLabel = lang === 'nl' ? 'Naar inhoud' : 'Skip to content';
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content={themeColor} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL.href} />

  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:site_name" content="Studio Wievien" />
  <meta property="og:locale" content={lang === 'nl' ? 'nl_NL' : 'en_US'} />
  {ogImageURL && <meta property="og:image" content={ogImageURL} />}

  <meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

  <script is:inline>
    try {
      const fancyArrivalKey = 'studio-wievien:fancy-arrival';
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const normalizePath = (path) => path.replace(/\/+$/, '') || '/';

      if (
        !reducedMotion &&
        normalizePath(window.location.pathname) === '/fancy-boogers' &&
        sessionStorage.getItem(fancyArrivalKey) === '1'
      ) {
        document.documentElement.classList.add('fancy-arrival-pending');
      }
    } catch {}
  </script>

  <!-- Prototype font delivery. Self-host before launch. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap"
    rel="stylesheet"
  />

  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main-content">{skipLabel}</a>

  <div data-page-shell>
    {!hideChrome && <Header lang={lang} currentPath={currentPath} />}

    <main id="main-content">
      <slot />
    </main>

    {!hideChrome && <Footer lang={lang} />}
  </div>

  <div class="fancy-transition-overlay" data-fancy-transition-overlay aria-hidden="true"></div>

  <script is:inline>
    (() => {
      const root = document.documentElement;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const fancyArrivalKey = 'studio-wievien:fancy-arrival';
      const fancyPath = '/fancy-boogers';
      const pullDuration = 430;
      const revealDuration = 560;
      let busy = false;

      const normalizePath = (path) => path.replace(/\/+$/, '') || '/';

      const closeMobileMenu = () => {
        document.querySelectorAll('.mobile-menu[open]').forEach((menu) => {
          menu.removeAttribute('open');
        });
      };

      const cleanup = () => {
        root.classList.remove(
          'fancy-arrival-pending',
          'is-fancy-transitioning',
          'is-fancy-pulling',
          'is-fancy-covered',
          'is-fancy-revealing'
        );
        busy = false;
      };

      const startTransition = (url) => {
        if (busy || reducedMotion.matches) return;
        busy = true;
        closeMobileMenu();
        root.classList.add('is-fancy-transitioning', 'is-fancy-pulling');

        window.setTimeout(() => {
          try {
            sessionStorage.setItem(fancyArrivalKey, '1');
          } catch {}
          window.location.assign(url.href);
        }, pullDuration);
      };

      document.addEventListener('click', (event) => {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) return;

        const link = event.target.closest('a[href]');
        if (!link || link.hasAttribute('download')) return;
        if (link.target && link.target !== '_self') return;

        let url;
        try {
          url = new URL(link.href, window.location.href);
        } catch {
          return;
        }

        if (url.origin !== window.location.origin) return;
        if (normalizePath(url.pathname) !== fancyPath) return;
        if (normalizePath(window.location.pathname) === fancyPath) return;
        if (reducedMotion.matches) return;

        event.preventDefault();
        startTransition(url);
      });

      const pendingArrival = root.classList.contains('fancy-arrival-pending');
      if (pendingArrival) {
        try {
          sessionStorage.removeItem(fancyArrivalKey);
        } catch {}

        root.classList.add('is-fancy-transitioning', 'is-fancy-covered');

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            root.classList.remove('fancy-arrival-pending');
            root.classList.add('is-fancy-revealing');
          });
        });

        window.setTimeout(cleanup, revealDuration + 180);
      }
    })();
  </script>
</body>
</html>
