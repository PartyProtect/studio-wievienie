---
interface Props {
  lang?: 'nl' | 'en';
  currentPath?: string;
}

const { lang = 'nl' } = Astro.props;

const nav = lang === 'nl'
  ? [
      { href: '/#werk', label: 'Werk' },
      { href: '/#fancy-boogers', label: 'Fancy Boogers' },
      { href: '/#borduurwerk', label: 'Borduurwerk' },
      { href: '/#workshops', label: 'Workshops' },
      { href: '/#over', label: 'Over' },
    ]
  : [
      { href: '/#work', label: 'Work' },
      { href: '/#fancy-boogers', label: 'Fancy Boogers' },
      { href: '/#embroidery', label: 'Embroidery' },
      { href: '/#workshops', label: 'Workshops' },
      { href: '/#about', label: 'About' },
    ];
---

<header class="site-header">
  <div class="shell header-inner">
    <a href="/" class="brand" aria-label="Studio Wievien home">Studio Wievien</a>

    <nav class="desktop-nav" aria-label={lang === 'nl' ? 'Hoofdnavigatie' : 'Main navigation'}>
      {nav.map(({ href, label }) => <a href={href}>{label}</a>)}
    </nav>

    <a
      class="instagram desktop-instagram"
      href="https://www.instagram.com/studio_wievien/"
      rel="noopener noreferrer"
      target="_blank"
    >
      Instagram ↗
    </a>

    <details class="mobile-menu">
      <summary>Menu</summary>
      <div class="mobile-panel">
        <nav aria-label={lang === 'nl' ? 'Mobiele navigatie' : 'Mobile navigation'}>
          {nav.map(({ href, label }) => <a href={href}>{label}</a>)}
          <a
            href="https://www.instagram.com/studio_wievien/"
            rel="noopener noreferrer"
            target="_blank"
          >Instagram ↗</a>
        </nav>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .header-inner {
    min-height: 70px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem;
  }

  .brand {
    font-family: var(--font-heading);
    font-size: 1.22rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .desktop-nav {
    display: flex;
    justify-content: center;
    gap: clamp(0.85rem, 2.2vw, 2rem);
  }

  .desktop-nav a,
  .instagram {
    font-size: 0.78rem;
    font-weight: 650;
    text-decoration: none;
    color: var(--text-mid);
    transition: color 180ms var(--ease);
  }

  .desktop-nav a:hover,
  .desktop-nav a:focus-visible,
  .instagram:hover,
  .instagram:focus-visible {
    color: var(--text);
  }

  .mobile-menu {
    display: none;
    position: relative;
  }

  .mobile-menu summary {
    list-style: none;
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 650;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-panel {
    position: fixed;
    top: 70px;
    left: 0;
    right: 0;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: 1rem var(--gutter) 1.5rem;
  }

  .mobile-panel nav {
    display: grid;
  }

  .mobile-panel a {
    padding: 0.82rem 0;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-heading);
    font-size: 1.35rem;
    text-decoration: none;
  }

  .mobile-panel a:last-child {
    border-bottom: 0;
  }

  @media (max-width: 850px) {
    .header-inner {
      grid-template-columns: 1fr auto;
      min-height: 62px;
    }

    .desktop-nav,
    .desktop-instagram {
      display: none;
    }

    .mobile-menu {
      display: block;
    }

    .mobile-panel {
      top: 62px;
    }
  }
</style>
