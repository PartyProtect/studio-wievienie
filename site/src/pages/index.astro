---
import BaseLayout from '@/layouts/BaseLayout.astro';

const sections = [
  { title: 'Werk', note: 'Selectie & projecten', href: '#werk' },
  { title: 'Fancy Boogers', note: 'Kledinglijn', href: '#fancy-boogers' },
  { title: 'Borduurwerk', note: 'Textiel & opdrachten', href: '#borduurwerk' },
  { title: 'Workshops', note: 'Borduren, textiel & upcycling', href: '#workshops' },
];

const projects = [
  { year: '2026', title: 'Carnavalproject', place: 'FASHIONCLASH' },
  { year: '2025', title: 'Studio Wievien bij Juunam', place: 'FASHIONCLASH Festival' },
  { year: '2024', title: 'New Fashion Narratives', place: 'Bureau Europa' },
];

const heroImage = 'https://images.squarespace-cdn.com/content/v1/5bf404ca70e8026f5a085d80/92c0dc63-a0bc-4686-81b0-d0bcc698c06b/Unknown.jpeg';
const juunamImage = 'https://images.squarespace-cdn.com/content/v1/5bf404ca70e8026f5a085d80/1767703456320-YMAS5DUHNMV0VR29ZRLF/MVS_20251120_0093_WEB.jpg';
const projectImage = 'https://images.squarespace-cdn.com/content/v1/5bf404ca70e8026f5a085d80/1772014449994-RK7LCIFVZK23UJQJ4WWS/538A4606_JonathanWiddershoven.jpg';
---

<BaseLayout
  title="Studio Wievien"
  description="Studio Wievien — mode, textiel, borduurwerk, objecten, projecten, workshops en Fancy Boogers."
  lang="nl"
  currentPath="/"
>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Wievien Alberts · Maastricht</p>
      <h1 id="hero-title">Studio<br />Wievien</h1>
      <p class="hero-fields">Mode · textiel · objecten · workshops</p>
      <p class="hero-lede">
        Eigen werk, Fancy Boogers, borduurwerk en projecten met anderen.
      </p>
      <a class="quiet-link" href="#werk">Werk bekijken <span aria-hidden="true">↓</span></a>
    </div>

    <figure class="hero-figure">
      <div class="hero-image-frame">
        <img
          src={heroImage}
          alt="Lichtblauw en lila hoofdobject van Studio Wievien met kralen voor het gezicht"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <figcaption>
        <span>Studio Wievien</span>
        <span>via FASHIONCLASH</span>
      </figcaption>
    </figure>
  </section>

  <nav class="section-index shell" aria-label="Onderdelen van Studio Wievien">
    {sections.map(({ title, note, href }) => (
      <a class="section-link" href={href}>
        <span class="section-name">{title}</span>
        <span class="section-note">{note}</span>
      </a>
    ))}
  </nav>

  <section class="selection" id="werk" aria-labelledby="selection-title">
    <div class="shell">
      <header class="section-header">
        <p class="eyebrow">Werk</p>
        <h2 id="selection-title">Selectie</h2>
      </header>

      <div class="selection-grid">
        <figure class="selection-main">
          <div class="image-frame image-frame-landscape">
            <img
              src={juunamImage}
              alt="Presentatie bij Juunam tijdens FASHIONCLASH Festival 2025"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>
            <div>
              <span class="caption-type">Presentatie</span>
              <strong>Juunam · FASHIONCLASH Festival 2025</strong>
            </div>
            <small>Foto: Mitch van Schijndel</small>
          </figcaption>
        </figure>

        <figure class="selection-side">
          <div class="image-frame image-frame-portrait">
            <img
              src={projectImage}
              alt="Beeld uit het FASHIONCLASH carnavalproject 2026"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>
            <div>
              <span class="caption-type">Project</span>
              <strong>Carnavalproject 2026 · FASHIONCLASH</strong>
            </div>
            <small>Foto: Jonathan Widdershoven</small>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="fancy" id="fancy-boogers" aria-labelledby="fancy-title">
    <div class="shell fancy-grid">
      <div>
        <p class="eyebrow">Kledinglijn</p>
        <h2 id="fancy-title">Fancy Boogers</h2>
      </div>
      <div class="fancy-copy">
        <p>De eigen kledinglijn van Studio Wievien.</p>
        <a
          class="dark-link"
          href="https://www.instagram.com/studio_wievien/"
          rel="noopener noreferrer"
          target="_blank"
        >@studio_wievien <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="practice shell" aria-label="Borduurwerk en workshops">
    <article class="practice-block" id="borduurwerk">
      <p class="eyebrow">Textiel</p>
      <h2>Borduurwerk</h2>
      <p>Borduurwerk en textielbewerking op kleding en andere dragers.</p>
    </article>

    <article class="practice-block" id="workshops">
      <p class="eyebrow">Workshops</p>
      <h2>Workshops</h2>
      <p>Borduren, textiel en upcycling.</p>
    </article>
  </section>

  <section class="projects shell" aria-labelledby="projects-title">
    <header class="projects-heading">
      <p class="eyebrow">Projecten & presentaties</p>
      <h2 id="projects-title">2024–2026</h2>
    </header>

    <div class="project-list">
      {projects.map(({ year, title, place }) => (
        <div class="project-row">
          <span class="project-year">{year}</span>
          <strong>{title}</strong>
          <span>{place}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="about" id="over" aria-labelledby="about-title">
    <div class="shell about-grid">
      <div>
        <p class="eyebrow">Over</p>
        <h2 id="about-title">Wievien Alberts</h2>
      </div>
      <div class="about-copy">
        <p>
          Wievien Alberts werkt met kleding, textiel, maskers en objecten. Ze maakt eigen werk,
          werkt aan projecten met anderen en geeft workshops. Maskers keren regelmatig terug in haar werk.
        </p>
        <a
          class="quiet-link"
          href="https://www.instagram.com/studio_wievien/"
          rel="noopener noreferrer"
          target="_blank"
        >Instagram <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: calc(100svh - 70px);
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(360px, 1.14fr);
    gap: clamp(2.5rem, 6vw, 7.5rem);
    align-items: center;
    padding-block: clamp(3rem, 6vw, 6rem);
  }

  .hero-copy {
    max-width: 620px;
  }

  .hero h1 {
    margin-top: 1rem;
    font-size: clamp(4.1rem, 8.1vw, 8rem);
    line-height: 0.82;
    letter-spacing: -0.055em;
  }

  .hero-fields {
    margin-top: 1.65rem;
    color: var(--text);
    font-size: clamp(0.92rem, 1.2vw, 1.05rem);
    letter-spacing: 0.01em;
  }

  .hero-lede {
    margin-top: 0.8rem;
    max-width: 31rem;
    color: var(--text-mid);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .quiet-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 2rem;
    padding-bottom: 0.18rem;
    border-bottom: 1px solid var(--border-dark);
    font-size: 0.78rem;
    font-weight: 650;
    text-decoration: none;
  }

  .quiet-link:hover,
  .quiet-link:focus-visible {
    border-color: var(--text);
  }

  .hero-figure {
    justify-self: end;
    width: min(100%, 660px);
  }

  .hero-image-frame {
    overflow: hidden;
    background: #f8f8f6;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--border) 65%, transparent);
  }

  .hero-figure img {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 39%;
  }

  .hero-figure figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.62rem;
    color: var(--text-light);
    font-size: 0.64rem;
    letter-spacing: 0.015em;
  }

  .section-index {
    margin-bottom: var(--section);
    border-top: 1px solid var(--border-dark);
  }

  .section-link {
    min-height: 92px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: center;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }

  .section-name {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3vw, 2.75rem);
    line-height: 1;
    transition: transform 180ms var(--ease);
  }

  .section-note {
    color: var(--text-mid);
    font-size: 0.74rem;
    text-align: right;
  }

  .section-link:hover .section-name,
  .section-link:focus-visible .section-name {
    transform: translateX(5px);
  }

  .selection {
    padding-block: var(--section);
    background: var(--bg-subtle);
  }

  .section-header {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .section-header h2,
  .practice h2,
  .projects h2,
  .about h2 {
    font-size: clamp(2.5rem, 4.8vw, 4.8rem);
    line-height: 0.92;
  }

  .selection-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(280px, 0.72fr);
    gap: clamp(1.25rem, 2.4vw, 2rem);
    align-items: start;
  }

  .image-frame {
    overflow: hidden;
    background: var(--bg-soft);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--border) 75%, transparent);
  }

  .image-frame img {
    height: 100%;
    object-fit: cover;
    transition: transform 360ms var(--ease);
  }

  figure:hover .image-frame img {
    transform: scale(1.008);
  }

  .image-frame-landscape {
    aspect-ratio: 3 / 2;
  }

  .image-frame-portrait {
    aspect-ratio: 4 / 5;
  }

  .selection figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 0.72rem;
  }

  .selection figcaption > div {
    display: grid;
    gap: 0.22rem;
  }

  .caption-type {
    color: var(--text-light);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .selection figcaption strong {
    font-size: 0.76rem;
    font-weight: 650;
    line-height: 1.35;
  }

  .selection figcaption small {
    flex: 0 0 auto;
    color: var(--text-light);
    font-size: 0.61rem;
    text-align: right;
  }

  .fancy {
    padding-block: clamp(5.5rem, 10vw, 9rem);
    background: var(--bg-ink);
    color: var(--text-on-dark);
  }

  .fancy .eyebrow {
    color: #918d87;
  }

  .fancy-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(260px, 0.7fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
  }

  .fancy h2 {
    margin-top: 0.8rem;
    font-size: clamp(4rem, 7vw, 7.5rem);
    line-height: 0.86;
    letter-spacing: -0.045em;
  }

  .fancy-copy {
    padding-bottom: 0.4rem;
  }

  .fancy-copy p {
    color: #c6c1ba;
    font-size: 0.95rem;
  }

  .dark-link {
    display: inline-flex;
    gap: 0.45rem;
    margin-top: 1.6rem;
    padding-bottom: 0.14rem;
    border-bottom: 1px solid #605d58;
    color: var(--text-on-dark);
    font-size: 0.76rem;
    text-decoration: none;
  }

  .practice {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding-block: var(--section);
    border-bottom: 1px solid var(--border-dark);
  }

  .practice-block {
    min-height: 270px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0 clamp(2rem, 5vw, 5rem) 0 0;
  }

  .practice-block + .practice-block {
    padding-left: clamp(2rem, 5vw, 5rem);
    padding-right: 0;
    border-left: 1px solid var(--border-dark);
  }

  .practice h2 {
    margin-top: 0.75rem;
  }

  .practice-block > p:last-child {
    max-width: 30rem;
    color: var(--text-mid);
    font-size: 0.9rem;
  }

  .projects {
    padding-block: var(--section);
  }

  .projects-heading {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .project-list {
    border-top: 1px solid var(--border-dark);
  }

  .project-row {
    display: grid;
    grid-template-columns: 90px minmax(0, 1.35fr) minmax(180px, 0.65fr);
    gap: 1rem;
    align-items: baseline;
    padding-block: 1.2rem;
    border-bottom: 1px solid var(--border);
  }

  .project-row strong {
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 1.8vw, 1.65rem);
    font-weight: 400;
  }

  .project-year,
  .project-row > span:last-child {
    color: var(--text-mid);
    font-size: 0.72rem;
  }

  .about {
    padding-block: var(--section);
    border-top: 1px solid var(--border-dark);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }

  .about h2 {
    margin-top: 0.75rem;
  }

  .about-copy {
    padding-top: 1.45rem;
  }

  .about-copy p {
    max-width: 36rem;
    color: var(--text-mid);
    font-size: clamp(1rem, 1.4vw, 1.14rem);
    line-height: 1.68;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }

    .hero h1 {
      font-size: clamp(4rem, 9vw, 6rem);
    }

    .selection-grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(240px, 0.75fr);
    }
  }

  @media (max-width: 720px) {
    .hero {
      min-height: 0;
      grid-template-columns: 1fr;
      gap: 2.4rem;
      padding-top: 2.5rem;
      padding-bottom: 4rem;
    }

    .hero h1 {
      font-size: clamp(4.3rem, 20vw, 6.3rem);
      line-height: 0.84;
    }

    .hero-fields {
      margin-top: 1.35rem;
    }

    .hero-figure {
      justify-self: stretch;
      width: 100%;
    }

    .section-index {
      margin-bottom: var(--section);
    }

    .section-link {
      min-height: 78px;
      gap: 1rem;
      padding-block: 0.95rem;
    }

    .section-name {
      font-size: 1.7rem;
    }

    .section-note {
      max-width: 14rem;
      font-size: 0.68rem;
    }

    .section-header,
    .projects-heading {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }

    .selection-grid {
      grid-template-columns: 1fr;
      gap: 3.25rem;
    }

    .image-frame-landscape {
      aspect-ratio: 4 / 3;
    }

    .selection-side {
      width: 100%;
      margin: 0;
    }

    .selection figcaption {
      display: grid;
      gap: 0.55rem;
    }

    .selection figcaption small {
      text-align: left;
    }

    .fancy-grid,
    .practice,
    .about-grid {
      grid-template-columns: 1fr;
    }

    .fancy-grid {
      gap: 3rem;
    }

    .fancy h2 {
      font-size: clamp(4rem, 18vw, 6rem);
    }

    .practice-block,
    .practice-block + .practice-block {
      min-height: 230px;
      padding: 0 0 3rem;
    }

    .practice-block + .practice-block {
      padding-top: 3rem;
      border-left: 0;
      border-top: 1px solid var(--border-dark);
    }

    .project-row {
      grid-template-columns: 52px 1fr;
      gap: 0.3rem 1rem;
    }

    .project-row > span:last-child {
      grid-column: 2;
    }

    .about-grid {
      gap: 1.4rem;
    }

    .about-copy {
      padding-top: 0;
    }
  }
</style>