    46%  { transform: translateX(33vw) translateY(0.024em) rotate(0.98deg) scale(1.011); }
    56%  { transform: translateX(40vw) translateY(0.03em) rotate(1.22deg) scale(1.013); }
    73%  { transform: translateX(11vw) translateY(0.012em) rotate(0.38deg) scale(1.004); }
