<style>
  .assembly-crew {
    position: absolute;
    left: clamp(-3.2rem, -3vw, -2rem);
    bottom: -0.45rem;
    z-index: 4;
    display: none;
    width: clamp(9.5rem, 13vw, 12rem);
    color: color-mix(in srgb, var(--ink) 82%, transparent);
    pointer-events: none;
  }

  .crew-figures {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .crew-rope {
    position: absolute;
    top: 1.15rem;
    left: 4.8rem;
    z-index: 1;
    width: 105vw;
    height: 4.5rem;
    overflow: visible;
    transform-origin: left 85%;
  }

  .crew-figures circle,
  .crew-figures path,
  .crew-rope path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .crew-figures circle,
  .crew-figures path {
    stroke-width: 2.05;
  }

  .crew-heavy,
  .crew-hat {
    stroke-width: 2.55 !important;
  }

  .crew-clipboard {
    stroke-width: 2.35 !important;
  }

  .crew-clipboard-mark {
    opacity: 0.52;
    stroke-width: 1.25 !important;
  }

  .crew-ground {
    opacity: 0;
    stroke-width: 1.45 !important;
  }

  .crew-rope path {
    stroke-width: 1.55;
  }

  .crew-rope-slack,
  .crew-rope-taut,
  .crew-supervisor,
  .crew-worker-stage {
    opacity: 0;
  }

  .crew-rope-taut {
    stroke-dasharray: 106;
    stroke-dashoffset: 106;
  }

  .crew-supervisor-arm {
    transform: rotate(82deg);
    transform-box: view-box;
    transform-origin: 29px 68px;
  }

  .crew-thumb {
    opacity: 0;
  }

  :global(html[data-assembly='pending']),
  :global(html[data-assembly='playing']) {
    overflow-x: clip;
  }

  :global(html[data-assembly='pending']) .assembly-crew,
  :global(html[data-assembly='playing']) .assembly-crew {
    display: block;
  }

  /* The load genuinely starts outside the viewport. */
  :global(html[data-assembly='pending'] [data-assemble='wievien']) {
    opacity: 1 !important;
    transform: translateX(105vw) translateY(0.06em) rotate(4.5deg) scale(1.018) !important;
  }

  :global(html[data-assembly='playing'] [data-assemble='wievien']) {
    animation: assembly-wievien-offscreen-haul 3700ms 1600ms linear both !important;
  }

  /* The rope shortens with roughly the same setbacks as the word. */
  :global(html[data-assembly='playing']) .crew-rope {
    animation: rope-rig-haul 3700ms 1600ms linear both;
  }

  /* Supporting information waits until the heavy move is well underway. */
  :global(html[data-assembly='playing'] [data-assemble='fields']) {
    animation-delay: 4100ms !important;
  }

  :global(html[data-assembly='playing'] [data-assemble='cta']) {
    animation-delay: 4580ms !important;
  }

  :global(html[data-assembly='playing'] [data-assemble='caption']) {
    animation-delay: 3900ms !important;
  }

  /* The supervisor approves the load before the lower site is released. */
  :global(html[data-assembly='playing'] [data-assemble='index']) {
    animation-delay: 6040ms !important;
  }

  :global(html[data-assembly='playing'] [data-assemble='door']:nth-child(1)) {
    animation-delay: 6200ms !important;
  }

  :global(html[data-assembly='playing'] [data-assemble='door']:nth-child(2)) {
    animation-delay: 6380ms !important;
  }

  :global(html[data-assembly='playing'] [data-assemble='door']:nth-child(3)) {
    animation-delay: 6560ms !important;
  }

  :global(html[data-assembly='playing'] [data-assemble='door']:nth-child(4)) {
    animation-delay: 6740ms !important;
  }

  :global(html[data-assembly='playing']) .assembly-crew {
    animation:
      crew-enter 720ms 1050ms var(--ease) both,
      crew-exit 700ms 6460ms var(--ease) both;
  }

  :global(html[data-assembly='playing']) .crew-ground {
    animation: crew-ground-in 560ms 1120ms ease-out both;
  }

  :global(html[data-assembly='playing']) .crew-supervisor {
    animation: supervisor-arrive 760ms 1260ms var(--ease) both;
  }

  :global(html[data-assembly='playing']) .crew-supervisor-arm {
    animation: supervisor-thumb 480ms 5480ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  :global(html[data-assembly='playing']) .crew-thumb {
    animation: thumb-appear 220ms 5700ms ease-out both;
  }

  :global(html[data-assembly='playing']) .crew-worker-stage {
    animation: worker-arrive 650ms 1160ms var(--ease) both;
  }

  :global(html[data-assembly='playing']) .crew-worker {
    animation: worker-haul 3920ms 1460ms linear both;
    transform-box: view-box;
    transform-origin: 65px 116px;
  }

  :global(html[data-assembly='playing']) .crew-rope-slack {
    animation: rope-slack 700ms 1190ms ease-out both;
  }

  :global(html[data-assembly='playing']) .crew-rope-taut {
    animation:
      rope-tighten 650ms 1360ms ease-out both,
      rope-strain 3550ms 1740ms linear both;
  }

  @keyframes assembly-wievien-offscreen-haul {
    0% {
      opacity: 1;
      transform: translateX(105vw) translateY(0.06em) rotate(4.5deg) scale(1.018);
    }
    12% {
      transform: translateX(88vw) translateY(0.052em) rotate(3.9deg) scale(1.016);
    }
    18% {
      transform: translateX(92vw) translateY(0.055em) rotate(4.1deg) scale(1.017);
    }
    36% {
      transform: translateX(63vw) translateY(0.038em) rotate(2.8deg) scale(1.012);
    }
    45% {
      transform: translateX(68vw) translateY(0.042em) rotate(3deg) scale(1.013);
    }
    64% {
      transform: translateX(35vw) translateY(0.021em) rotate(1.45deg) scale(1.006);
    }
    72% {
      transform: translateX(39vw) translateY(0.025em) rotate(1.65deg) scale(1.007);
    }
    86% {
